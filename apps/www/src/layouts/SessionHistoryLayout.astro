---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import InstallCommand from "../components/InstallCommand.astro";
import { localeConfig, type Locale } from "../data/landing";
import {
  createSessionHistoryPageConfig,
  sessionHistoryCopy,
  sessionHistoryRoutes,
  sessionHistoryUpdated,
} from "../data/session-history";
import LandingLayout from "./LandingLayout.astro";

interface Props {
  frontmatter: { locale: Locale };
}

const { locale } = Astro.props.frontmatter;
const t = sessionHistoryCopy[locale];
---

<LandingLayout locale={locale} page={createSessionHistoryPageConfig(locale)}>
  <div class="console-ui min-h-dvh bg-[var(--console-bg)] text-[var(--console-text)]">
    <Header locale={locale} languageRoutes={sessionHistoryRoutes} />
    <main class="px-4 py-12 sm:px-6 sm:py-16">
      <article class="mx-auto max-w-[760px]">
        <header class="mb-10 border-b border-[var(--console-border)] pb-8">
          <a class="footer-link" href={localeConfig[locale].route}>
            {t.home}
          </a>
          <h1 class="console-display mt-6 text-3xl font-semibold leading-tight tracking-tight sm:text-5xl">
            {t.title}
          </h1>
          <p class="mt-4 text-sm text-[var(--console-muted)]">
            {t.updated}{" "}
            <time datetime={sessionHistoryUpdated}>
              {sessionHistoryUpdated}
            </time>
          </p>
        </header>
        <div class="guide-content">
          <slot />
        </div>
        <section
          class="mt-12 border-t border-[var(--console-border)] pt-8"
          aria-labelledby="guide-start"
        >
          <h2
            id="guide-start"
            class="console-display mb-5 text-xl font-semibold"
          >
            {t.start}
          </h2>
          <InstallCommand locale={locale} showEndpoint />
          <a
            class="footer-link mt-6 inline-block"
            href={localeConfig[locale].route}
          >
            {t.home}
          </a>
        </section>
      </article>
    </main>
    <Footer locale={locale} />
  </div>
</LandingLayout>

<style>
  .guide-content {
    color: var(--console-text-secondary);
    font-size: 1rem;
    line-height: 1.85;
    overflow-wrap: anywhere;
  }
  .guide-content :global(h2) {
    margin: 2.75rem 0 1rem;
    color: var(--console-text);
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.4;
    scroll-margin-top: 5rem;
  }
  .guide-content :global(p),
  .guide-content :global(ul),
  .guide-content :global(ol) {
    margin: 1rem 0;
  }
  .guide-content :global(ul) {
    list-style: disc;
    padding-left: 1.5rem;
  }
  .guide-content :global(ol) {
    list-style: decimal;
    padding-left: 1.5rem;
  }
  .guide-content :global(li) {
    margin: 0.6rem 0;
  }
  .guide-content :global(strong) {
    color: var(--console-text);
  }
  .guide-content :global(a) {
    color: var(--brand-text);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .guide-content :global(a:focus-visible) {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }
  .guide-content :global(code) {
    font-family: "JetBrains Mono Variable", monospace;
    font-size: 0.85em;
  }
  .guide-content :global(pre) {
    margin: 1.25rem 0;
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
  }
</style>
