---
import type { Locale } from "../data/landing";
import InstallCommand from "./InstallCommand.astro";

interface Props {
  locale: Locale;
  id: string;
}

const { locale, id } = Astro.props;
const labels = {
  en: {
    method: "Installation method",
    npm: "macOS / Linux / Windows · Node.js 22+",
    curl: "macOS / Linux x64 (glibc 2.35+) · No Node.js required",
    brew: "macOS · Homebrew required · No Node.js required",
    scoop: "Windows x64 · Scoop required · No Node.js required",
    start:
      "After installing, run codesesh. Stop CodeSesh before updating, then restart it.",
    update: "Update:",
    rerun: "Run the install command again.",
  },
  zh: {
    method: "安装方式",
    npm: "macOS / Linux / Windows · 需要 Node.js 22+",
    curl: "macOS / Linux x64（glibc 2.35+）· 无需 Node.js",
    brew: "macOS · 需要 Homebrew · 无需 Node.js",
    scoop: "Windows x64 · 需要 Scoop · 无需 Node.js",
    start: "安装后运行 codesesh。更新前停止 CodeSesh，完成后重新启动。",
    update: "更新：",
    rerun: "再次运行安装命令。",
  },
  ja: {
    method: "インストール方法",
    npm: "macOS / Linux / Windows · Node.js 22以降が必要",
    curl: "macOS / Linux x64（glibc 2.35以降）· Node.js不要",
    brew: "macOS · Homebrewが必要 · Node.js不要",
    scoop: "Windows x64 · Scoopが必要 · Node.js不要",
    start:
      "インストール後、codeseshを実行。更新前にCodeSeshを停止し、更新後に再起動してください。",
    update: "更新：",
    rerun: "インストールコマンドを再実行。",
  },
}[locale];
const methods = [
  {
    id: "npm",
    name: "npm",
    command: "npx codesesh@latest",
    note: labels.npm,
    update: "npx codesesh@latest",
  },
  {
    id: "curl",
    name: "curl",
    command: "curl -sSfL https://codesesh.xingkaixin.me/install.sh | sh",
    note: labels.curl,
    update: labels.rerun,
  },
  {
    id: "brew",
    name: "brew",
    command: "brew install xingkaixin/tap/codesesh",
    note: labels.brew,
    update: "brew upgrade codesesh",
  },
  {
    id: "scoop",
    name: "scoop",
    command:
      "scoop bucket add xingkaixin https://github.com/xingkaixin/scoop-bucket\nscoop install xingkaixin/codesesh",
    note: labels.scoop,
    update: "scoop update codesesh",
  },
];
---

<div class="install-options" data-install-options>
  <p class="inst-l" id={`${id}-label`}>
    {labels.method}
  </p>
  <div class="ctabs" role="tablist" aria-labelledby={`${id}-label`}>
    {methods.map((method, index) => (
      <button
        type="button"
        role="tab"
        id={`${id}-tab-${method.id}`}
        aria-controls={`${id}-panel-${method.id}`}
        aria-selected={index === 0}
        tabindex={index === 0 ? 0 : -1}
        data-install-method={method.id}
      >
        {method.name}
      </button>
    ))}
  </div>
  {methods.map((method, index) => (
    <div
      class="ipanel"
      role="tabpanel"
      id={`${id}-panel-${method.id}`}
      aria-labelledby={`${id}-tab-${method.id}`}
      data-install-panel={method.id}
      hidden={index !== 0}
    >
      <InstallCommand
        locale={locale}
        command={method.command}
        method={method.id}
        placement={id}
        tone="ember"
      />
      <p class="cnote">
        {method.note}
        {method.id !== "npm" && (
          <>
            <br />
            {labels.start}
          </>
        )}
        <br />
        {labels.update} <code>{method.update}</code>
      </p>
    </div>
  ))}
</div>

<script>
  document
    .querySelectorAll<HTMLElement>("[data-install-options]")
    .forEach((group) => {
      const tabs = Array.from(
        group.querySelectorAll<HTMLButtonElement>("[role=tab]"),
      );
      const panels = group.querySelectorAll<HTMLElement>(
        "[data-install-panel]",
      );
      function selectTab(selected: HTMLButtonElement) {
        tabs.forEach((tab) => {
          const active = tab === selected;
          tab.setAttribute("aria-selected", String(active));
          tab.tabIndex = active ? 0 : -1;
        });
        panels.forEach((panel) => {
          panel.hidden =
            panel.dataset.installPanel !== selected.dataset.installMethod;
        });
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener("click", () => selectTab(tab));
        tab.addEventListener("keydown", (event) => {
          let next: number;
          switch (event.key) {
            case "ArrowRight":
              next = (index + 1) % tabs.length;
              break;
            case "ArrowLeft":
              next = (index + tabs.length - 1) % tabs.length;
              break;
            case "Home":
              next = 0;
              break;
            case "End":
              next = tabs.length - 1;
              break;
            default:
              return;
          }
          event.preventDefault();
          const nextTab = tabs[next];
          if (!nextTab) return;
          selectTab(nextTab);
          nextTab.focus();
        });
      });
    });
</script>

<style>
  .install-options {
    min-width: 0;
  }
  .inst-l {
    margin: 0 0 12px;
    color: rgba(255, 255, 255, 0.9);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .ctabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 13px;
    background: rgba(0, 0, 0, 0.2);
  }
  [role="tab"] {
    height: 38px;
    padding: 0 15px;
    border-radius: 10px;
    color: rgba(255, 255, 255, 0.9);
    font: 600 12.5px/1 var(--mono);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  [role="tab"]:hover {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }
  [role="tab"][aria-selected="true"] {
    background: #fff;
    color: #7a3a1d;
  }
  [role="tab"]:focus-visible {
    outline-color: #fff;
  }
  .ipanel {
    margin-top: 12px;
  }
  .cnote {
    margin: 14px 0 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: 12.5px;
    line-height: 1.75;
  }
  .cnote code {
    padding: 1px 6px;
    border-radius: 5px;
    background: rgba(0, 0, 0, 0.2);
    font-family: var(--mono);
  }
</style>
