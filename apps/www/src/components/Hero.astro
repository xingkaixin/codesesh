---
import { agents, copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";
import InstallCommand from "./InstallCommand.astro";
import SectionBackground from "./SectionBackground.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].hero;
---

<section
  class="landing-background px-4 sm:px-6 lg:px-7"
  aria-labelledby="hero-heading"
>
  <SectionBackground variant="hero" />
  <div class="mx-auto max-w-[1180px] pb-20 pt-20 sm:pb-24 sm:pt-24">
    <div class="hero-copy max-w-[54rem]">
      <p class="console-eyebrow mb-5">{t.eyebrow}</p>
      <h1
        id="hero-heading"
        class="console-display landing-heading max-w-[15em] text-[clamp(2.4rem,5.4vw,4.25rem)] font-bold leading-[1.06] text-[var(--console-text)]"
      >
        <HeadingText value={t.title} />
      </h1>
      <p
        class="mt-6 max-w-[42rem] text-[1.05rem] leading-8 text-[var(--console-text-secondary)]"
      >
        {t.body}
        {t.privacy}
      </p>

      <div class="mt-8">
        <InstallCommand locale={locale} showEndpoint />
      </div>

      <div
        class="mt-7 flex flex-wrap items-center gap-2.5"
        aria-label={t.agentsLabel}
      >
        <span class="console-eyebrow mr-1">{t.agentsLabel}</span>
        <ul class="flex flex-wrap items-center gap-2.5">
          {
            agents.map((agent) => (
              <li
                class="flex size-6 items-center justify-center rounded-xs"
                aria-label={agent.name}
                title={agent.name}
              >
                {"iconColored" in agent && agent.iconColored ? (
                  <img
                    src={agent.icon}
                    alt=""
                    width="17"
                    height="17"
                    class="size-[17px]"
                  />
                ) : (
                  <span
                    aria-hidden="true"
                    class="inline-block size-[17px] bg-[var(--console-text)] opacity-80"
                    style={`mask: url("${agent.icon}") center / contain no-repeat; -webkit-mask: url("${agent.icon}") center / contain no-repeat;`}
                  />
                )}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>
