---
import { experience } from "../data/experience";
import { agents, copy, type Locale } from "../data/landing";
import { sections } from "../data/sections";
import Icon from "./Icon.astro";
import InstallCommand from "./InstallCommand.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].hero;
const s = sections[locale];
const actions = experience[locale];
const featuredAgents = agents.filter(({ name }) =>
  ["Claude Code", "Codex", "Cursor", "OpenCode"].includes(name),
);
const lanes = [
  "M118 72 C 170 72, 170 225, 209 225",
  "M100 168 C 160 168, 160 225, 209 225",
  "M100 282 C 160 282, 160 225, 209 225",
  "M118 378 C 170 378, 170 225, 209 225",
];
const sourceTops = ["16%", "37.3%", "62.7%", "84%"];
const results = [
  {
    agent: "Claude Code",
    project: "api-gateway",
    age: "2d",
    before: "Fix ",
    hit: "refresh token race",
    after: " in session middleware",
  },
  {
    agent: "Codex",
    project: "web-console",
    age: "5d",
    before: "Retry 401 with single-flight ",
    hit: "refresh",
    after: "",
  },
];
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner section-shell">
    <div class="hero__copy hero-copy">
      <p class="hero__eyebrow console-mono">
        <span class="hero__live" aria-hidden="true"></span>
        {t.eyebrow}
      </p>
      <h1 id="hero-heading" class="console-display landing-heading">
        <span>{t.title[0]}</span>
        <span>{t.title[1]}</span>
      </h1>
      <p class="hero__body">{t.body}</p>
      <div class="hero__command">
        <InstallCommand
          locale={locale}
          command={t.command}
          method="npm"
          placement="hero"
        />
      </div>
      <div class="hero__actions">
        <a class="button-primary pressable" href="#install">
          {actions.start}
          <Icon name="arrow-up-right" />
        </a>
        <a class="text-link" href="#tour">
          {actions.tour}
          <Icon name="arrow-right" />
        </a>
      </div>
      <p class="hero__privacy">
        <Icon name="shield" />
        {t.privacy}
      </p>
    </div>

    <div class="hero-visual hero__visual" role="img" aria-label={s.heroVisual}>
      <svg
        class="hero__lanes"
        viewBox="0 0 550 450"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        {lanes.map((d) => (
          <path class="hero__lane" d={d} vector-effect="non-scaling-stroke" />
        ))}
        {lanes.map((d, index) => (
          <path
            class={`hero__flow hero__flow--${index + 1}`}
            d={d}
            vector-effect="non-scaling-stroke"
          />
        ))}
      </svg>
      {featuredAgents.map((agent, index) => (
        <span class="hero__source" style={`top:${sourceTops[index]}`}>
          <span
            class="agent-mark"
            style={`mask-image:url('${agent.icon}')`}
            aria-hidden="true"
          ></span>
          {agent.name}
          {index === featuredAgents.length - 1 && (
            <span class="console-mono hero__more">
              +{agents.length - featuredAgents.length}
            </span>
          )}
        </span>
      ))}

      <div class="hero__card" aria-hidden="true">
        <div class="hero__card-bar">
          <span class="hero__live"></span>
          <span class="console-mono">localhost:4521</span>
          <span class="hero__tag console-mono">
            {copy[locale].tour.sampleLabel}
          </span>
        </div>
        <div class="hero__card-body">
          <div class="hero__search console-mono">
            <Icon name="search" />
            <span>
              <span class="hero__typed">refresh token race</span>
              <span class="hero__caret"></span>
            </span>
          </div>
          <p class="hero__result hero__count console-mono">{s.heroResults}</p>
          {results.map((result, index) => (
            <div
              class="hero__result"
              style={`animation-delay:${0.15 * (index + 1)}s`}
            >
              <div class="hero__result-meta">
                <span class="hero__tag console-mono">{result.agent}</span>
                <span class="console-mono">{result.project}</span>
                <span class="hero__age">{result.age}</span>
              </div>
              <p>
                {result.before}
                <mark>{result.hit}</mark>
                {result.after}
              </p>
            </div>
          ))}
          <div class="hero__result" style="animation-delay:0.45s">
            <div class="hero__result-meta">
              <span class="hero__tag console-mono">Cursor</span>
              <span class="console-mono">api-gateway</span>
              <span class="hero__age">1w</span>
            </div>
            <p class="console-mono hero__edit">
              Edit src/auth/<mark>refresh</mark>.ts <ins>+18</ins>
              <del>−6</del>
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    border-bottom: 1px solid var(--console-border);
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--console-border) 1px, transparent 1px),
      linear-gradient(90deg, var(--console-border) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: linear-gradient(90deg, transparent 15%, #000 70%);
    opacity: 0.6;
  }
  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 3.5rem;
    align-items: center;
    padding-block: 6rem 5.5rem;
  }
  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }
  .hero__eyebrow {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.1rem;
    margin: 0;
    padding: 0 0.9rem;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-pill);
    background: var(--console-surface);
    color: var(--console-text-secondary);
    font-size: 0.75rem;
    letter-spacing: 0.03em;
  }
  .hero__live {
    position: relative;
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 99px;
    background: var(--brand);
  }
  .hero__live::after {
    content: "";
    position: absolute;
    inset: -4px;
    border: 1px solid var(--brand);
    border-radius: 99px;
    animation: hero-ping 2.4s var(--ease-out) infinite;
  }
  h1 {
    margin: 0;
    font-size: clamp(2.8rem, 6vw, 5rem);
    font-weight: 600;
    letter-spacing: -0.045em;
    line-height: 1.03;
  }
  h1 span {
    display: block;
  }
  h1 span + span {
    color: var(--brand-text);
  }
  :lang(zh-CN) h1,
  :lang(ja) h1 {
    font-size: clamp(2.6rem, 4.6vw, 4.25rem);
    line-height: 1.18;
    letter-spacing: -0.02em;
  }
  .hero__body {
    max-width: 32rem;
    margin: 0;
    color: var(--console-text-secondary);
    font-size: 1.07rem;
    line-height: 1.7;
    text-wrap: pretty;
  }
  .hero__command {
    max-width: 28rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }
  .hero__privacy {
    display: flex;
    gap: 0.6rem;
    max-width: 30rem;
    margin: 0;
    color: var(--console-muted);
    font-size: 0.8rem;
    line-height: 1.6;
  }
  .hero__privacy :global(svg) {
    flex: none;
    margin-top: 0.15rem;
  }

  .hero__visual {
    position: relative;
    width: 100%;
    aspect-ratio: 11 / 9;
  }
  .hero__lanes {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .hero__lane {
    fill: none;
    stroke: var(--console-border-strong);
    stroke-width: 1.2;
  }
  .hero__flow {
    fill: none;
    stroke: var(--brand);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-dasharray: 3 22;
    animation: hero-flow 1.8s linear infinite;
  }
  .hero__flow--2 {
    stroke: var(--signal);
    animation-duration: 2.3s;
  }
  .hero__flow--3 {
    animation-duration: 1.5s;
  }
  .hero__flow--4 {
    stroke: var(--signal);
    animation-duration: 2.7s;
  }
  .hero__source {
    position: absolute;
    left: 0;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.2rem;
    padding: 0 0.85rem 0 0.6rem;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-pill);
    background: var(--console-surface);
    color: var(--console-text-secondary);
    font-size: 0.8rem;
    white-space: nowrap;
    transform: translateY(-50%);
  }
  .hero__source .agent-mark {
    width: 1rem;
    height: 1rem;
  }
  .hero__more {
    color: var(--console-muted);
    font-size: 0.72rem;
  }
  .hero__card {
    position: absolute;
    inset: 10% 0 10% 38%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-xl);
    background: var(--console-surface);
    box-shadow: var(--elevation-overlay);
  }
  .hero__card-bar {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--console-border);
    color: var(--console-muted);
    font-size: 0.72rem;
  }
  .hero__card-bar .hero__tag {
    margin-left: auto;
  }
  .hero__tag {
    padding: 0.1rem 0.45rem;
    border: 1px solid var(--console-border-strong);
    border-radius: var(--radius-sm);
    color: var(--console-muted);
    font-size: 0.66rem;
  }
  .hero__card-body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem;
  }
  .hero__search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 2.8rem;
    padding: 0 0.85rem;
    border: 1px solid var(--console-border-strong);
    border-radius: var(--radius-md);
    background: var(--console-surface-muted);
    color: var(--console-text);
    font-size: 0.9rem;
  }
  .hero__search :global(svg) {
    flex: none;
    color: var(--console-muted);
  }
  .hero__typed {
    display: inline-block;
    width: 0;
    overflow: hidden;
    white-space: nowrap;
    vertical-align: bottom;
    animation: hero-type 10s steps(18, end) infinite;
  }
  .hero__caret {
    display: inline-block;
    width: 2px;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: -0.2em;
    background: var(--brand);
    animation: hero-blink 1s steps(1) infinite;
  }
  .hero__result {
    opacity: 0;
    animation: hero-result 10s var(--ease-out) infinite;
  }
  .hero__count {
    margin: 0.4rem 0.1rem 0;
    color: var(--console-muted);
    font-size: 0.72rem;
  }
  div.hero__result {
    padding: 0.75rem;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-md);
    background: var(--console-surface);
  }
  .hero__result-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--console-muted);
    font-size: 0.72rem;
  }
  .hero__age {
    margin-left: auto;
  }
  .hero__result p {
    margin: 0.5rem 0 0;
    color: var(--console-text);
    font-size: 0.85rem;
    font-weight: 500;
  }
  .hero__result p.hero__edit {
    font-size: 0.78rem;
    font-weight: 400;
  }
  .hero__result mark {
    padding: 0 2px;
    border-radius: 3px;
    background: var(--signal-soft);
    color: var(--signal);
  }
  .hero__result ins {
    color: var(--brand-text);
    text-decoration: none;
  }
  .hero__result del {
    color: var(--signal);
    text-decoration: none;
  }

  @keyframes hero-ping {
    0% {
      opacity: 1;
      transform: scale(0.6);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  @keyframes hero-flow {
    to {
      stroke-dashoffset: -50;
    }
  }
  @keyframes hero-type {
    0%,
    6% {
      width: 0;
    }
    26%,
    88% {
      width: 18ch;
    }
    96%,
    100% {
      width: 0;
    }
  }
  @keyframes hero-blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes hero-result {
    0%,
    28% {
      opacity: 0;
      transform: translateY(10px);
    }
    34%,
    86% {
      opacity: 1;
      transform: none;
    }
    93%,
    100% {
      opacity: 0;
      transform: translateY(-4px);
    }
  }

  @media (max-width: 1023px) {
    .hero__inner {
      grid-template-columns: minmax(0, 1fr);
      padding-block: 4rem;
    }
    .hero__visual {
      max-width: 40rem;
    }
  }
  @media (max-width: 639px) {
    .hero__lanes,
    .hero__source {
      display: none;
    }
    .hero__visual {
      aspect-ratio: auto;
    }
    .hero__card {
      position: relative;
      inset: auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__live::after,
    .hero__flow,
    .hero__caret {
      animation: none;
    }
    .hero__typed {
      width: 18ch;
      animation: none;
    }
    .hero__result {
      opacity: 1;
      animation: none;
    }
  }
</style>
