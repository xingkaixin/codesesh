---
import { experience } from "../data/experience";
import { agents, copy, type Locale } from "../data/landing";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const featuredAgents = agents.filter(({ name }) =>
  ["Claude Code", "Codex", "Cursor", "OpenCode"].includes(name),
);
---

<section class="hero" aria-labelledby="hero-heading">
  <div class="hero__inner section-shell">
    <div class="hero__copy">
      <p class="hero__intro">{t.intro}</p>
      <h1 id="hero-heading" class="console-display">
        <span>{t.title[0]}</span>
        <span>{t.title[1]}</span>
      </h1>
      <p class="hero__body">{t.body}</p>
      <div class="hero__actions">
        <a class="button-primary" href="#install">
          {t.start}
          <Icon name="arrow-up-right" />
        </a>
        <a class="text-link" href="#tour">
          {t.tour}
          <Icon name="arrow-right" />
        </a>
      </div>
    </div>
    <div class="hero__art" aria-hidden="true">
      <img
        class="hero__image hero__image--light"
        src="/artwork/archive-light-1536.webp"
        srcset="/artwork/archive-light-768.webp 768w, /artwork/archive-light-1536.webp 1536w"
        sizes="(max-width: 767px) 100vw, 65vw"
        width="1536"
        height="1024"
        alt=""
        fetchpriority="high"
      />
      <img
        class="hero__image hero__image--dark"
        src="/artwork/archive-dark-1536.webp"
        srcset="/artwork/archive-dark-768.webp 768w, /artwork/archive-dark-1536.webp 1536w"
        sizes="(max-width: 767px) 100vw, 65vw"
        width="1536"
        height="1024"
        alt=""
        fetchpriority="high"
      />
    </div>
  </div>
  <div class="hero__foundation section-shell">
    <div class="hero__agents" aria-label={copy[locale].hero.agentsLabel}>
      {featuredAgents.map((agent) => (
        <span class="hero__agent">
          <span
            class="hero__agent-icon"
            style={`mask-image:url('${agent.icon}')`}
            aria-hidden="true"
          ></span>
          {agent.name}
        </span>
      ))}
      <a href="#agents" class="hero__agent-more">
        +{agents.length - featuredAgents.length}
        <span class="sr-only"> {experience[locale].agentsCount}</span>
        <Icon name="arrow-right" />
      </a>
    </div>
    <p class="hero__local">
      <Icon name="shield" />
      {locale === "zh"
        ? "本地运行。免费开源。"
        : locale === "ja"
          ? "ローカル実行。無料・オープンソース。"
          : "Local by default. Open source, always."}
    </p>
  </div>
</section>

<style>
  .hero {
    overflow: clip;
  }
  .hero__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    min-height: min(42rem, calc(100svh - 10rem));
    padding-block: 5rem;
  }
  .hero__copy {
    position: relative;
    z-index: 1;
  }
  .hero__intro {
    margin: 0 0 1.8rem;
    color: var(--brand-text);
    font-size: 0.83rem;
    font-weight: 500;
  }
  h1 {
    margin: 0;
    font-size: clamp(3.6rem, 6.3vw, 6.4rem);
    font-weight: 500;
    letter-spacing: -0.075em;
    line-height: 1.03;
  }
  h1 span {
    display: block;
    white-space: nowrap;
  }
  h1 span + span {
    color: var(--brand-text);
  }
  .hero__body {
    max-width: 29rem;
    margin: 1.9rem 0 0;
    color: var(--console-text-secondary);
    font-size: 1.07rem;
    line-height: 1.75;
    text-wrap: pretty;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.75rem;
    margin-top: 2.2rem;
  }
  .hero__art {
    position: absolute;
    top: 50%;
    right: -13%;
    width: 74%;
    translate: 0 -50%;
    pointer-events: none;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 12%,
      #000 93%,
      transparent
    );
  }
  .hero__image {
    width: 100%;
    height: auto;
    mask-image: linear-gradient(
      180deg,
      transparent,
      #000 13%,
      #000 84%,
      transparent
    );
  }
  .hero__image--dark {
    display: none;
  }
  :global(.dark) .hero__image--light {
    display: none;
  }
  :global(.dark) .hero__image--dark {
    display: block;
  }
  .hero__foundation {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
    align-items: center;
    padding-block: 1.8rem;
    border-top: 1px solid var(--console-border);
  }
  .hero__agents {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
    align-items: center;
  }
  .hero__agent {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    font-size: 0.82rem;
    font-weight: 500;
  }
  .hero__agent-icon {
    width: 20px;
    height: 20px;
    background: var(--console-text);
    mask-size: contain;
    mask-position: center;
    mask-repeat: no-repeat;
  }
  .hero__agent-more {
    display: inline-flex;
    gap: 0.4rem;
    align-items: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--console-text-secondary);
  }
  .hero__local {
    display: flex;
    gap: 0.55rem;
    align-items: center;
    color: var(--console-text-secondary);
    font-size: 0.75rem;
  }
  :global(:lang(zh-CN)) h1 {
    font-size: clamp(3.5rem, 5.4vw, 5.5rem);
    letter-spacing: -0.055em;
    line-height: 1.18;
  }
  :global(:lang(ja)) h1 {
    font-size: clamp(2.7rem, 3.9vw, 4.1rem);
    letter-spacing: -0.06em;
    line-height: 1.3;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__copy {
      animation: hero-enter 0.75s var(--ease-out) both;
    }
    .hero__art {
      animation: art-enter 1.15s var(--ease-out) both;
    }
    @keyframes hero-enter {
      from {
        opacity: 0;
        transform: translateY(18px);
      }
    }
    @keyframes art-enter {
      from {
        opacity: 0;
        transform: translate(24px, 12px) scale(0.96);
      }
    }
    @supports (animation-timeline: view()) {
      .hero__image {
        animation: archive-drift linear both;
        animation-timeline: view();
        animation-range: exit 0% exit 100%;
      }
      @keyframes archive-drift {
        to {
          transform: translateY(8%) rotate(-3deg);
        }
      }
    }
  }
  @media (max-width: 1023px) {
    .hero__inner {
      min-height: 39rem;
      padding-block: 4.5rem;
    }
    .hero__local {
      display: none;
    }
    .hero__foundation {
      justify-content: center;
    }
  }
  @media (max-width: 767px) {
    .hero__inner {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      min-height: auto;
      padding-block: 3.25rem 0;
    }
    .hero__intro {
      margin-bottom: 1.25rem;
      font-size: 0.78rem;
    }
    h1 {
      font-size: clamp(2.15rem, 10.9vw, 5.8rem);
    }
    :global(:lang(zh-CN)) h1 {
      font-size: clamp(2.9rem, 10.6vw, 4.6rem);
    }
    :global(:lang(ja)) h1 {
      font-size: clamp(2rem, 7.3vw, 3.3rem);
    }
    .hero__body {
      margin-top: 1.35rem;
      max-width: 33rem;
      font-size: 0.98rem;
    }
    .hero__actions {
      gap: 1.3rem;
      margin-top: 1.5rem;
    }
    .hero__art {
      position: relative;
      top: auto;
      right: auto;
      translate: none;
      width: 124%;
      margin: 0.75rem -12% -0.5rem;
    }
    .hero__foundation {
      padding-block: 1.5rem;
    }
    .hero__agents {
      justify-content: center;
      column-gap: 1.25rem;
      row-gap: 1rem;
    }
    .hero__agent {
      font-size: 0.7rem;
      gap: 0.4rem;
    }
    .hero__agent-icon {
      width: 16px;
      height: 16px;
    }
  }
</style>
