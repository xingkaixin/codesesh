---
import { agentGuideSlugs, guideRoutes } from "../data/guides";
import { agents, copy, type Locale } from "../data/landing";
import { fill } from "../data/showcase";
import AgentIcon from "./AgentIcon.astro";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";
import InstallCommand from "./InstallCommand.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].hero;
const featuredNames = [
  "Claude Code",
  "Codex",
  "Cursor",
  "OpenCode",
  "Gemini CLI",
  "Pi",
] as const;
const featuredAgents = featuredNames
  .map((name) => agents.find((entry) => entry.name === name))
  .filter((entry): entry is (typeof agents)[number] => Boolean(entry));
const remainingCount = Math.max(0, agents.length - featuredAgents.length);
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage" data-hero-stage>
    <picture class="hero-art">
      <source srcset="/hero-topography.avif" type="image/avif" />
      <source srcset="/hero-topography.webp" type="image/webp" />
      <img
        src="/hero-topography.webp"
        alt=""
        width="1536"
        height="1024"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
    <canvas
      class="hero-canvas"
      data-hero-canvas
      data-mask-src="/hero-topography-mask.webp"
      aria-hidden="true"
    ></canvas>
    <script is:inline>
      (function () {
        var stage =
          document.currentScript && document.currentScript.parentElement;
        if (!stage) return;
        var reduced =
          typeof window.matchMedia === "function" &&
          window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        var still = window.location.search.indexOf("still") !== -1;
        if (!reduced && !still) stage.dataset.heroAnim = "pending";
      })();
    </script>
    <div class="hero-veil" aria-hidden="true"></div>

    <div class="shell hero-content">
      <div class="hero-copy">
        <h1 class="hero-h1" id="hero-title">
          <HeadingText value={t.title} secondClass="" />
        </h1>
        <p class="hero-lead">{t.body}</p>
        <div class="hero-action">
          <div class="hero-cta-row">
            <InstallCommand
              locale={locale}
              method="npm"
              placement="hero"
              tone="hero"
            />
            <a class="hero-preview-btn" href="#tour">
              <span>{t.previewCta}</span>
              <Icon name="arrow" class="size-4" />
            </a>
          </div>
          <p class="hero-note">
            <span>{t.trustNote}</span> <a href="#install">{t.otherInstalls}</a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <div class="agent-strip" aria-label={copy[locale].header.agents}>
    <div class="agent-grid">
      {featuredAgents.map((agent) => {
        const slug = agentGuideSlugs[agent.name];
        const href = slug ? guideRoutes(slug)[locale] : "#agents";
        return (
          <a class="agent-cell" href={href}>
            <span class="agent-ic" aria-hidden="true">
              <AgentIcon name={agent.name} size={20} />
            </span>
            <span>{agent.name}</span>
          </a>
        );
      })}
      <a class="agent-cell agent-more" href="#agents">
        <span>{fill(t.moreAgents, { count: remainingCount })}</span>
      </a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - 69px);
    overflow: hidden;
    background: #0f1013;
  }

  .hero-stage {
    position: relative;
    display: flex;
    flex: 1 0 auto;
    align-items: center;
    min-height: 520px;
    overflow: hidden;
    background: #e6e4de;
  }

  :global(.dark) .hero-stage {
    background: #0f1014;
  }

  .hero-art {
    position: absolute;
    inset: 0;
    pointer-events: none;
    transition: opacity 0.35s ease;
  }

  .hero-art img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center bottom;
  }

  .hero-canvas {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .hero-stage[data-hero-anim="pending"] .hero-art,
  .hero-stage[data-hero-anim="active"] .hero-art {
    opacity: 0;
  }

  .hero-stage[data-hero-anim="active"] .hero-canvas {
    opacity: 1;
  }

  /* Directional veil keeps dark-mode stone sky deep obsidian while preserving the ember crest on the right */
  .hero-veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      120deg,
      rgba(232, 230, 224, 0.42) 0%,
      rgba(232, 230, 224, 0.14) 44%,
      rgba(232, 230, 224, 0) 68%
    );
  }

  :global(.dark) .hero-veil {
    background: linear-gradient(
      142deg,
      rgba(11, 12, 16, 0.92) 0%,
      rgba(11, 12, 16, 0.82) 42%,
      rgba(11, 12, 16, 0.28) 70%,
      rgba(11, 12, 16, 0.04) 100%
    );
  }

  .hero-content {
    position: relative;
    z-index: 3;
    padding-top: clamp(64px, 7vh, 112px);
    padding-bottom: clamp(112px, 15vh, 210px);
  }

  .hero-copy {
    max-width: 720px;
  }

  .hero-h1 {
    margin: 0;
    color: #121318;
    font-size: clamp(30px, 5vw, 64px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
    word-break: keep-all;
    overflow-wrap: anywhere;
  }

  :lang(zh-CN) .hero-h1,
  :lang(ja) .hero-h1 {
    line-height: 1.12;
  }

  :global(.dark) .hero-h1 {
    color: #f3f2ef;
  }

  .hero-lead {
    max-width: 520px;
    margin: 24px 0 0;
    color: #363942;
    font-size: 16px;
    line-height: 1.7;
  }

  :global(.dark) .hero-lead {
    color: #c4c3cc;
  }

  .hero-action {
    margin-top: 36px;
  }

  .hero-cta-row {
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 12px;
  }

  .hero-preview-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 56px;
    padding: 0 22px;
    border: 1px solid rgba(20, 21, 25, 0.22);
    background: rgba(243, 242, 239, 0.78);
    backdrop-filter: blur(8px);
    color: #121318;
    font: 600 14px/1 var(--sans);
    white-space: nowrap;
    transition:
      background-color 0.16s var(--ease-out),
      border-color 0.16s var(--ease-out);
  }

  .hero-preview-btn:hover {
    border-color: rgba(20, 21, 25, 0.42);
    background: rgba(255, 255, 255, 0.92);
  }

  :global(.dark) .hero-preview-btn {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(20, 21, 25, 0.72);
    color: #f3f2ef;
  }

  :global(.dark) .hero-preview-btn:hover {
    border-color: rgba(255, 255, 255, 0.38);
    background: rgba(30, 31, 38, 0.9);
  }

  .hero-note {
    margin: 14px 0 0;
    color: #363942;
    font-size: 13px;
    line-height: 1.6;
  }

  .hero-note a {
    color: #121318;
    font-family: var(--mono);
    font-size: 12.5px;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  :global(.dark) .hero-note {
    color: #b6b5bd;
  }

  :global(.dark) .hero-note a {
    color: #f3f2ef;
  }

  /* Crisp full-bleed dark 7-column supported-agents anchor bar */
  .agent-strip {
    position: relative;
    z-index: 2;
    border-top: 1px solid #26282f;
    background: #0f1013;
  }

  .agent-grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    max-width: 1440px;
    margin: 0 auto;
  }

  .agent-cell {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    height: 84px;
    padding: 0 12px;
    border-left: 1px solid #23252c;
    color: #e6e5e0;
    font-size: 14px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background-color 0.16s var(--ease-out),
      color 0.16s var(--ease-out);
  }

  .agent-cell:first-child {
    border-left: 0;
  }

  .agent-cell:hover {
    background: #17191f;
    color: #ffffff;
  }

  .agent-cell:focus-visible {
    outline-color: #ff7a45;
    outline-offset: -3px;
  }

  .agent-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: #f3f2ef;
    opacity: 0.92;
  }

  .agent-ic :global(img) {
    border-radius: 4px;
  }

  .agent-more {
    color: #b6b5bd;
    font-family: var(--mono);
    font-size: 13.5px;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 1080px) {
    .agent-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
    .agent-cell {
      height: 68px;
      border-top: 1px solid #23252c;
    }
    .agent-cell:nth-child(-n + 4) {
      border-top: 0;
    }
    .agent-cell:nth-child(4n + 1) {
      border-left: 0;
    }
    .agent-more {
      grid-column: span 2;
    }
  }

  @media (max-width: 760px) {
    .hero-stage {
      align-items: flex-start;
      min-height: 460px;
    }
    .hero-art img {
      object-position: 72% bottom;
    }
    .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(232, 230, 224, 0.78) 0%,
        rgba(232, 230, 224, 0.56) 54%,
        rgba(232, 230, 224, 0.08) 82%,
        rgba(232, 230, 224, 0) 100%
      );
    }
    :global(.dark) .hero-veil {
      background: linear-gradient(
        180deg,
        rgba(11, 12, 16, 0.92) 0%,
        rgba(11, 12, 16, 0.78) 54%,
        rgba(11, 12, 16, 0.16) 86%,
        rgba(11, 12, 16, 0.04) 100%
      );
    }
    .hero-content {
      padding-top: 56px;
      padding-bottom: 148px;
    }
    .hero-lead {
      font-size: 15px;
    }
    .hero-action {
      margin-top: 28px;
    }
    .hero-preview-btn {
      width: 100%;
      min-height: 48px;
    }
    .agent-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .agent-cell {
      height: 56px;
      font-size: 13px;
      border-top: 1px solid #23252c;
      border-left: 1px solid #23252c;
    }
    .agent-cell:nth-child(-n + 2) {
      border-top: 0;
    }
    .agent-cell:nth-child(odd) {
      border-left: 0;
    }
    .agent-more {
      grid-column: span 2;
      border-left: 0;
    }
  }
</style>

<script>
  import { initHeroStage } from "../scripts/hero-stage";

  initHeroStage();
</script>
