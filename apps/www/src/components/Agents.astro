---
import { experience } from "../data/experience";
import { agents, copy, type Locale } from "../data/landing";
import { showcase, splitTitle } from "../data/showcase";
import AgentIcon from "./AgentIcon.astro";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const a = showcase[locale].agents;
---

<section id="agents" class="sec" aria-labelledby="agents-heading">
  <div class="shell agw">
    <div data-reveal>
      <p class="eyebrow">
        <span class="n">05</span>
        <span class="ln"></span>
        {copy[locale].header.agents}
      </p>
      <h2 id="agents-heading" class="h2">
        <HeadingText value={splitTitle(t.agentsTitle)} />
      </h2>
      <p class="big">
        <b>{agents.length}</b>
        <span>{t.agentsCount}</span>
      </p>
      <p class="lead agents-body">{copy[locale].agents.body}</p>
    </div>
    <div data-reveal>
      <ul class="keys" aria-label={t.agentsList}>
        {agents.map((agent) => (
          <li class="key">
            <AgentIcon name={agent.name} size={20} />
            <span data-agent-name>{agent.name}</span>
            {agent.partial && <span class="partial">{a.partial}</span>}
          </li>
        ))}
      </ul>
      <p class="ag-foot">
        <Icon name="info" class="size-3.5" />
        {a.note}
      </p>
    </div>
  </div>
</section>

<style>
  .agw {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: 64px;
    align-items: center;
  }
  .big {
    display: flex;
    align-items: flex-end;
    gap: 16px;
    margin: 40px 0 0;
  }
  .big b {
    color: var(--text);
    font: 300 136px/0.82 var(--mono);
    letter-spacing: -0.07em;
  }
  .big span {
    padding-bottom: 6px;
    color: var(--text-2);
    font-size: 14px;
    font-weight: 500;
  }
  .agents-body {
    margin-top: 28px;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .key {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    height: 46px;
    padding: 0 16px 0 12px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    background: var(--surface);
    box-shadow: 0 3px 0 var(--border-strong);
    color: var(--text);
    font-size: 13px;
    font-weight: 600;
    transition:
      transform 0.12s var(--ease-out),
      box-shadow 0.12s var(--ease-out);
  }
  .key:hover {
    box-shadow: 0 1px 0 var(--border-strong);
    transform: translateY(2px);
  }
  .partial {
    padding: 3px 5px;
    border-radius: 5px;
    background: var(--warn-soft);
    color: var(--warn-ink);
    font: 600 9.5px/1 var(--sans);
  }
  .ag-foot {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin: 22px 0 0;
    color: var(--muted);
    font-size: 12px;
  }
  .ag-foot :global(svg) {
    flex: none;
    margin-top: 2px;
  }
  @media (max-width: 1023px) {
    .agw {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .big b {
      font-size: 96px;
    }
  }
</style>
