---
import { agents, copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].agents;
---

<section
  class="border-t border-[var(--console-border)] bg-[var(--console-surface)] px-4 py-20 sm:px-6"
  aria-labelledby="agents-heading"
>
  <div class="mx-auto max-w-7xl">
    <h2
      id="agents-heading"
      class="console-display landing-heading max-w-2xl text-3xl font-semibold leading-tight text-[var(--console-text)] md:text-4xl"
    >
      <HeadingText value={t.title} />
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--console-text-secondary)]">{t.body}</p>

    <ul class="mt-10 flex flex-wrap gap-2.5">
      {
        agents.map((agent) => (
          <li class="motion-hover flex items-center gap-2 rounded-full border border-[var(--console-border)] bg-[var(--console-surface-muted)] px-3.5 py-2 hover:border-[var(--brand-line)] hover:bg-[var(--brand-soft)]">
            {
              "iconColored" in agent && agent.iconColored ? (
                <img
                  src={agent.icon}
                  alt={agent.name}
                  width="16"
                  height="16"
                  class="size-4 object-contain"
                  loading="lazy"
                />
              ) : (
                <span
                  role="img"
                  aria-label={agent.name}
                  class="inline-block size-4 bg-[var(--console-text)]"
                  style={`mask: url("${agent.icon}") center / contain no-repeat; -webkit-mask: url("${agent.icon}") center / contain no-repeat;`}
                />
              )
            }
            <span class="console-mono text-[11px] font-medium text-[var(--console-text)]">
              {agent.name}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
