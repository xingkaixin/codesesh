---
import { experience } from "../data/experience";
import { agents, copy, type Locale } from "../data/landing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const half = Math.ceil(agents.length / 2);
const rows = [agents, [...agents.slice(half), ...agents.slice(0, half)]];
---

<section id="agents" class="agents" aria-labelledby="agents-heading">
  <div class="section-shell agents__intro" data-reveal>
    <p class="agents__count">
      <strong class="console-display">{agents.length}</strong>
      <span class="console-mono">{t.agentsCount}</span>
    </p>
    <div>
      <p class="landing-kicker">
        <b>05</b>
        {copy[locale].header.agents}
      </p>
      <h2 id="agents-heading" class="section-heading">
        {t.agentsTitle}
      </h2>
      <p class="section-body">{copy[locale].agents.body}</p>
    </div>
  </div>

  <ul class="sr-only">
    {agents.map((agent) => (
      <li>{agent.name}</li>
    ))}
  </ul>
  <div class="agents__rows" aria-hidden="true">
    {rows.map((row, index) => (
      <div class="agents__viewport">
        <div class:list={["agents__track", index === 1 && "is-reverse"]}>
          {[...row, ...row].map((agent, i) => (
            <span
              class="agents__item console-display"
              data-duplicate={i >= row.length ? "" : undefined}
            >
              <span class="agents__icon">
                <span
                  class="agent-mark"
                  style={`mask-image:url('${agent.icon}')`}
                ></span>
              </span>
              {agent.name}
            </span>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .agents {
    padding-block: clamp(4.5rem, 8vw, 7rem);
    border-block: 1px solid var(--console-border);
    background: var(--console-surface-sunken);
    scroll-margin-top: 4rem;
  }
  .agents__intro {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: 3rem;
    align-items: end;
    margin-bottom: 3.5rem;
  }
  .agents__count {
    display: flex;
    align-items: flex-end;
    gap: 1rem;
    margin: 0;
  }
  .agents__count strong {
    font-size: clamp(6rem, 12vw, 10rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.85;
  }
  .agents__count span {
    padding-bottom: 0.9rem;
    color: var(--console-muted);
    font-size: 0.8rem;
  }
  .agents__rows {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .agents__viewport {
    overflow: hidden;
    mask-image: linear-gradient(
      90deg,
      transparent,
      #000 10%,
      #000 90%,
      transparent
    );
  }
  .agents__track {
    display: flex;
    width: max-content;
    gap: 0.75rem;
    animation: agents-marquee 48s linear infinite;
  }
  .agents__track.is-reverse {
    animation-direction: reverse;
    animation-duration: 56s;
  }
  .agents__rows:hover .agents__track {
    animation-play-state: paused;
  }
  .agents__item {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0 1.4rem 0 0.85rem;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-lg);
    background: var(--console-surface);
    font-size: 1rem;
    font-weight: 500;
    white-space: nowrap;
  }
  .agents__icon {
    display: inline-flex;
    width: 2.1rem;
    height: 2.1rem;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-md);
    background: var(--console-surface-muted);
    color: var(--console-text);
  }
  .agents__icon .agent-mark {
    width: 1.25rem;
    height: 1.25rem;
  }

  @keyframes agents-marquee {
    to {
      transform: translateX(-50%);
    }
  }

  @media (max-width: 1023px) {
    .agents__intro {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .agents__track {
      flex-wrap: wrap;
      width: auto;
      padding-inline: 1.5rem;
      animation: none;
    }
    .agents__rows > :last-child {
      display: none;
    }
    .agents__item[data-duplicate] {
      display: none;
    }
  }
</style>
