---
import Header from "./Header.astro";
import Footer from "./Footer.astro";
import LandingLayout from "../layouts/LandingLayout.astro";
import {
  guideCopy,
  guidePageConfig,
  guideRoutes,
  guides,
} from "../data/guides";
import type { Locale } from "../data/landing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = guideCopy[locale];
const categories = ["start", "connect", "understand"] as const;
---

<LandingLayout locale={locale} page={guidePageConfig(locale)}>
  <div class="console-ui min-h-dvh bg-[var(--console-bg)] text-[var(--console-text)]">
    <Header locale={locale} page="guides" languageRoutes={guideRoutes()} />
    <main class="mx-auto max-w-[1056px] px-4 py-14 sm:px-6 sm:py-20">
      <header class="mb-14 max-w-[680px]">
        <h1 class="console-display text-4xl font-semibold leading-tight tracking-tight sm:text-5xl">
          {t.title}
        </h1>
        <p class="mt-6 text-lg leading-8 text-[var(--console-text-secondary)]">
          {t.description}
        </p>
      </header>
      {categories.map((category) => (
        <section
          class="grid gap-5 border-t border-[var(--console-border)] py-9 md:grid-cols-[200px_minmax(0,1fr)] md:gap-12"
          aria-labelledby={`category-${category}`}
        >
          <h2
            id={`category-${category}`}
            class="console-display text-xl font-semibold"
          >
            {t[category]}
          </h2>
          <ul class="space-y-8">
            {guides
              .filter((guide) => guide.category === category)
              .map((guide) => (
                <li>
                  <h3 class="text-lg font-semibold leading-7">
                    <a
                      class="guide-link"
                      href={guideRoutes(guide.slug)[locale]}
                    >
                      {guide.copy[locale].title}
                    </a>
                  </h3>
                  <p class="mt-2 max-w-[68ch] text-sm leading-7 text-[var(--console-text-secondary)]">
                    {guide.copy[locale].description}
                  </p>
                </li>
              ))}
          </ul>
        </section>
      ))}
    </main>
    <Footer locale={locale} />
  </div>
</LandingLayout>
