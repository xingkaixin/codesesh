---
import { copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";
import InstallCommand from "./InstallCommand.astro";
import SectionBackground from "./SectionBackground.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].cta;
---

<section
  class="px-4 pb-4 pt-24 sm:px-6 sm:pt-28 lg:px-7"
  aria-labelledby="cta-heading"
>
  <div
    class="landing-background mx-auto flex max-w-[1180px] flex-col gap-8 rounded-xl border border-[var(--console-border)] bg-[var(--console-surface)] px-6 py-8 shadow-[var(--shadow-raised)] sm:px-9 sm:py-10 lg:flex-row lg:items-center lg:justify-between"
  >
    <SectionBackground variant="cta" />
    <div class="max-w-xl">
      <h2
        id="cta-heading"
        class="console-display landing-heading text-2xl font-semibold leading-[1.2] text-[var(--console-text)] sm:text-[1.75rem]"
      >
        <HeadingText value={t.title} />
      </h2>
      <p
        class="mt-3 max-w-[52ch] text-sm leading-7 text-[var(--console-text-secondary)]"
      >
        {t.body}
      </p>
    </div>

    <div
      class="flex shrink-0 flex-col items-start gap-3 sm:flex-row sm:items-center"
    >
      <InstallCommand locale={locale} />
      <a
        href="https://github.com/xingkaixin/codesesh"
        target="_blank"
        rel="noopener noreferrer"
        class="pressable console-mono inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-md border border-[var(--console-text)] bg-[var(--console-text)] px-5 text-xs font-semibold text-[var(--console-bg)] hover:bg-[var(--console-text-secondary)] focus-visible:ring-2 focus-visible:ring-[var(--brand)] focus-visible:ring-offset-2 focus-visible:ring-offset-[var(--console-surface)] focus-visible:outline-none"
      >
        <span aria-hidden="true">★&nbsp;</span>{t.github}
      </a>
    </div>
  </div>
</section>
