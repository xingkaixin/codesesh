---
import { experience } from "../data/experience";
import { copy, type Locale } from "../data/landing";
import { sections } from "../data/sections";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";
import InstallOptions from "./InstallOptions.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const s = sections[locale].install;
---

<section id="install" class="cta-sec" aria-labelledby="cta-heading">
  <div class="shell">
    <div class="cta" data-reveal>
      <div>
        <p class="eyebrow">
          <span class="n">08</span>
          <span class="ln"></span>
          {s.label}
        </p>
        <h2 id="cta-heading" class="h2">
          <HeadingText value={t.installTitle} secondClass="" />
        </h2>
        <p class="lead">{t.installBody}</p>
        <div class="cbtns">
          <a class="btn white" href="https://github.com/xingkaixin/codesesh">
            <Icon name="github" />
            {copy[locale].cta.github}
          </a>
        </div>
      </div>
      <InstallOptions locale={locale} id="cta-install" />
    </div>
  </div>
</section>

<style>
  .cta-sec {
    padding: 24px 0 32px;
  }
  .cta {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: 56px;
    align-items: end;
    overflow: hidden;
    padding: 76px 64px;
    border-radius: 30px;
    background: linear-gradient(135deg, var(--ember-from), var(--ember-to));
    color: #fff;
  }
  .cta::before {
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.07) 0 2px,
      transparent 2px 11px
    );
    content: "";
    pointer-events: none;
    mask-image: linear-gradient(to left, #000, transparent 72%);
  }
  .cta > * {
    position: relative;
  }
  .cta .eyebrow {
    color: rgba(255, 255, 255, 0.9);
  }
  .cta .eyebrow .n {
    color: #fff;
  }
  .cta .eyebrow .ln {
    background: rgba(255, 255, 255, 0.4);
  }
  .cta .lead {
    margin-top: 22px;
    color: rgba(255, 255, 255, 0.9);
  }
  .cbtns {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 36px;
  }
  .btn.white {
    background: #fff;
    color: #7a3a1d;
  }
  .btn.white:hover {
    background: #fdede5;
  }
  @media (max-width: 900px) {
    .cta {
      grid-template-columns: minmax(0, 1fr);
      padding: 52px 28px;
    }
  }
  @media (max-width: 760px) {
    .cta {
      padding: 40px 20px;
    }
  }
</style>
