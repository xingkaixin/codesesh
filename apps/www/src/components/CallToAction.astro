---
import { experience } from "../data/experience";
import type { Locale } from "../data/landing";
import InstallOptions from "./InstallOptions.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
---

<section
  id="install"
  class="installation section-space"
  aria-labelledby="cta-heading"
>
  <div class="section-shell installation-inner" data-reveal>
    <div>
      <h2 id="cta-heading" class="section-heading">
        <span>{t.installTitle[0]}</span>
        <span>{t.installTitle[1]}</span>
      </h2>
      <p class="section-body">{t.installBody}</p>
    </div>
    <InstallOptions locale={locale} id="cta-install" />
  </div>
</section>
<style>
  .installation {
    background: var(--brand-soft);
  }
  .installation-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5rem;
    align-items: center;
  }
  .installation h2 {
    font-size: clamp(2.4rem, 4.5vw, 4.5rem);
    letter-spacing: -0.06em;
  }
  .installation h2 span {
    display: block;
  }
  .installation h2 span + span {
    color: var(--brand-text);
  }
  .installation .section-body {
    max-width: 27rem;
  }
  .installation :global(.install-options) {
    max-width: none;
    background: var(--console-bg);
    border-color: var(--console-border-strong);
    border-radius: var(--radius-md);
  }
  @media (max-width: 1023px) {
    .installation-inner {
      gap: 2.5rem;
    }
  }
  @media (max-width: 767px) {
    .installation-inner {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
