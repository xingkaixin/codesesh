---
import { copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].faq;
---

<section class="border-t border-[var(--console-border)] px-4 py-20 sm:px-6 md:py-24" aria-labelledby="faq-heading">
  <div class="mx-auto grid max-w-7xl gap-10 lg:grid-cols-[0.72fr_1.28fr] lg:gap-14">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2
        id="faq-heading"
        class="console-display landing-heading max-w-lg text-3xl font-semibold leading-tight text-[var(--console-text)] md:text-4xl"
      >
        <HeadingText value={t.title} />
      </h2>
      <p class="mt-5 max-w-md text-base leading-8 text-[var(--console-text-secondary)]">{t.body}</p>
    </div>

    <div class="divide-y divide-[var(--console-border)] overflow-hidden rounded-lg border border-[var(--console-border)] bg-[var(--console-surface)] shadow-[var(--shadow-raised)]">
      {
        t.items.map((item) => (
          <article class="px-5 py-6 sm:px-6">
            <h3 class="console-display text-lg font-semibold text-[var(--console-text)]">
              {item.question}
            </h3>
            <p class="mt-3 text-sm leading-7 text-[var(--console-muted)]">{item.answer}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
