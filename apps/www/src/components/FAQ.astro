---
import { copy, type FAQItem, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].faq;
const items: FAQItem[] = t.items;
---

<section
  id="faq"
  class="faq-section section-space"
  aria-labelledby="faq-heading"
>
  <div class="section-shell faq-layout">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <h2 id="faq-heading" class="section-heading">
        <HeadingText value={t.title} />
      </h2>
      <p class="section-body">{t.body}</p>
    </div>

    <div>
      {items.map((item, index) => (
        <details
          class:list={[
            "group border-t border-[var(--console-border)]",
            index === items.length - 1 && "border-b",
          ]}
        >
          <summary class="flex min-h-16 cursor-pointer list-none items-center gap-4 py-4 focus-visible:ring-2 focus-visible:ring-[var(--brand)] focus-visible:outline-none [&::-webkit-details-marker]:hidden">
            <h3 class="flex-1 text-[15px] font-semibold text-[var(--console-text)]">
              {item.question}
            </h3>
            <span
              class="faq-chevron text-[var(--console-muted)]"
              aria-hidden="true"
            >
              <Icon name="chevron-right" class="size-4" />
            </span>
          </summary>
          <div class="max-w-[64ch] pb-5 pr-8 text-sm leading-7 text-[var(--console-text-secondary)]">
            <p>{item.answer}</p>
            {item.link && (
              <a class="footer-link mt-2 block w-fit" href={item.link.href}>
                {item.link.label}
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-section {
    border-top: 1px solid var(--console-border);
    padding-top: 5rem;
  }
  .faq-layout {
    display: grid;
    grid-template-columns: 1fr 1.15fr;
    gap: 6rem;
  }
  .faq-layout h2 {
    max-width: 8em;
    font-size: clamp(2rem, 3.6vw, 3.4rem);
  }
  .faq-layout .section-body {
    max-width: 22rem;
    font-size: 0.9rem;
  }
  @media (max-width: 1023px) {
    .faq-layout {
      gap: 3rem;
    }
  }
  @media (max-width: 767px) {
    .faq-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .faq-layout h2 {
      max-width: none;
    }
    .faq-section {
      padding-top: 4rem;
    }
  }
</style>
