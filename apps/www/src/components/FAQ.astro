---
import { copy, type FAQItem, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].faq;
const items: FAQItem[] = t.items;
---

<section id="faq" class="sec" aria-labelledby="faq-heading">
  <div class="shell faq">
    <div class="faq-intro" data-reveal>
      <p class="eyebrow">
        <span class="n">07</span>
        <span class="ln"></span>FAQ
      </p>
      <h2 id="faq-heading" class="h2">
        <HeadingText value={t.title} />
      </h2>
      <p class="lead">{t.body}</p>
    </div>
    <div data-reveal>
      {items.map((item, index) => (
        <details class="qa" open={index === 0}>
          <summary>
            <span class="qn" aria-hidden="true">
              0{index + 1}
            </span>
            <h3>{item.question}</h3>
            <span class="pm" aria-hidden="true">
              <Icon name="plus" />
            </span>
          </summary>
          <div class="ans">
            <p>{item.answer}</p>
            {item.link && (
              <a class="tlink" href={item.link.href}>
                {item.link.label}
                <Icon name="arrow" />
              </a>
            )}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 64px;
  }
  .faq-intro .lead {
    margin-top: 22px;
  }
  .qa {
    border-top: 1px solid var(--border);
  }
  .qa:last-child {
    border-bottom: 1px solid var(--border);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 24px 0;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary h3 {
    flex: 1;
    margin: 0;
    font-size: 16.5px;
    font-weight: 500;
  }
  .qn {
    flex: none;
    width: 24px;
    color: var(--muted);
    font: 500 11px/1 var(--mono);
  }
  .qa[open] .qn {
    color: var(--brand-ink);
  }
  .pm {
    display: grid;
    flex: none;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--surface);
    transition:
      transform 0.3s var(--ease-out),
      background 0.2s,
      border-color 0.2s;
  }
  .qa[open] .pm {
    border-color: var(--brand-line);
    background: var(--brand-soft);
    color: var(--brand-ink);
    transform: rotate(45deg);
  }
  .ans {
    padding: 0 56px 26px 40px;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.85;
  }
  .ans p {
    margin: 0;
  }
  .ans .tlink {
    margin-top: 12px;
  }
  .qa[open] .ans {
    animation: drop 0.35s var(--ease-settle) both;
  }
  @media (max-width: 1023px) {
    .faq {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .ans {
      padding: 0 0 24px 40px;
    }
  }
</style>
