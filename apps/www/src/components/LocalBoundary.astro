---
import { experience } from "../data/experience";
import type { Locale } from "../data/landing";
import { sections } from "../data/sections";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const s = sections[locale].local;
const nodeIcons = ["file", "scan", "database", "monitor"] as const;
---

<section id="local" class="sec" aria-labelledby="local-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <div>
        <h2 id="local-heading" class="h2">
          <HeadingText value={t.localTitle} />
        </h2>
      </div>
      <div>
        <p class="lead">{t.localBody}</p>
        <a class="tlink local-link" href="#faq">
          {t.localLink}
          <Icon name="arrow" />
        </a>
      </div>
    </div>
    <div class="lb" data-reveal>
      <div class="bd">
        <span class="bd-tag">
          <Icon name="laptop" class="size-3.5" />
          {s.boundary}
        </span>
        <ol class="chain">
          {s.chain.map(([title, sub], index) => (
            <>
              {index > 0 && (
                <li class="conn" aria-hidden="true">
                  <span class="pk" />
                </li>
              )}
              <li class:list={["node", index === s.chain.length - 1 && "web"]}>
                <span class="node-ic">
                  <Icon name={nodeIcons[index]!} />
                </span>
                <div class="node-t">{title}</div>
                <div class="node-s">{sub}</div>
              </li>
            </>
          ))}
        </ol>
      </div>
      <div class="block" aria-hidden="true">
        <span class="stop">
          <Icon name="close" />
        </span>
      </div>
      <div class="cloud">
        <Icon name="cloud-off" class="size-5.5" />
        <div class="t">{s.cloud}</div>
        <div class="s">{s.cloudNote}</div>
      </div>
    </div>
    <p class="lb-note" data-reveal>
      <Icon name="server" />
      {s.worker}
    </p>
  </div>
</section>

<style>
  .local-link {
    margin-top: 18px;
  }
  .lb {
    display: flex;
    align-items: stretch;
  }
  .bd {
    position: relative;
    flex: 1;
    min-width: 0;
    padding: 56px 28px 30px;
    border: 1.5px dashed var(--border-strong);
    border-radius: 24px;
    background-color: var(--surface);
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .bd-tag {
    position: absolute;
    top: -14px;
    left: 26px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    height: 28px;
    padding: 0 13px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-fg);
    font-size: 12px;
    font-weight: 600;
  }
  .chain {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .node {
    flex: 1 1 0;
    min-width: 0;
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--sh-raised);
  }
  .node-ic {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin-bottom: 14px;
    border-radius: 11px;
    background: var(--brand-soft);
    color: var(--brand-ink);
  }
  .node-t {
    font-size: 14.5px;
    font-weight: 600;
  }
  .node-s {
    margin-top: 4px;
    color: var(--muted);
    font: 400 11px/1.5 var(--mono);
  }
  .node.web {
    border-color: var(--ink);
    background: var(--ink);
    color: var(--ink-fg);
  }
  .node.web .node-s {
    color: color-mix(in oklab, var(--ink-fg) 72%, transparent);
  }
  .node.web .node-ic {
    background: var(--brand);
    color: #fff;
  }
  .conn {
    position: relative;
    flex: 0 0 48px;
    height: 2px;
    background: repeating-linear-gradient(
      to right,
      var(--border-strong) 0 4px,
      transparent 4px 8px
    );
  }
  .pk {
    position: absolute;
    top: -3px;
    left: 0;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--brand);
    animation: travel 1.8s linear infinite;
  }
  .conn:nth-child(4) .pk {
    animation-delay: 0.6s;
  }
  .conn:nth-child(6) .pk {
    animation-delay: 1.2s;
  }
  .block {
    position: relative;
    display: flex;
    flex: 0 0 112px;
    align-items: center;
    justify-content: center;
  }
  .block::before {
    position: absolute;
    top: 50%;
    right: 0;
    left: 0;
    border-top: 1.5px dashed var(--border-strong);
    content: "";
  }
  .stop {
    position: relative;
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1.5px solid var(--err-ink);
    border-radius: 50%;
    background: var(--surface);
    color: var(--err-ink);
  }
  .cloud {
    flex: 0 0 200px;
    align-self: center;
    padding: 18px;
    border: 1.5px dashed var(--border-strong);
    border-radius: 18px;
    background: var(--panel);
    color: var(--muted);
  }
  .cloud .t {
    margin-top: 12px;
    color: var(--text-2);
    font-size: 14px;
    font-weight: 600;
    text-decoration: line-through;
    text-decoration-color: var(--err-ink);
    text-decoration-thickness: 1.5px;
  }
  .cloud .s {
    margin-top: 4px;
    font-size: 12px;
  }
  .lb-note {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    max-width: 760px;
    margin: 28px 0 0;
    padding: 16px 18px;
    border: 1px solid var(--border);
    border-radius: 14px;
    background: var(--surface);
    color: var(--text-2);
    font-size: 13.5px;
  }
  .lb-note :global(svg) {
    flex: none;
    margin-top: 2px;
    color: var(--brand-ink);
  }

  @keyframes travel {
    0% {
      left: -4px;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      left: calc(100% - 4px);
      opacity: 0;
    }
  }
  @keyframes travel-y {
    0% {
      top: -4px;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: calc(100% - 4px);
      opacity: 0;
    }
  }

  @media (max-width: 1023px) {
    .lb {
      flex-direction: column;
    }
    .block {
      flex-basis: 64px;
    }
    .block::before {
      top: 0;
      right: auto;
      bottom: 0;
      left: 50%;
      border-top: 0;
      border-left: 1.5px dashed var(--border-strong);
    }
    .cloud {
      flex-basis: auto;
      align-self: stretch;
    }
  }
  @media (max-width: 760px) {
    .chain {
      flex-direction: column;
      align-items: stretch;
    }
    .conn {
      flex: 0 0 40px;
      align-self: center;
      width: 2px;
      height: 40px;
      background: repeating-linear-gradient(
        to bottom,
        var(--border-strong) 0 4px,
        transparent 4px 8px
      );
    }
    .pk {
      top: 0;
      left: -3px;
      animation-name: travel-y;
    }
    .bd {
      padding: 52px 16px 18px;
    }
  }
</style>
