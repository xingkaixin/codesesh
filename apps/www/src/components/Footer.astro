---
const year = new Date().getFullYear();
---

<footer class="border-t border-[var(--console-border)] bg-[var(--console-surface)] px-4 py-8 sm:px-6">
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <span class="console-display text-sm font-semibold text-[var(--console-text)]">CodeSesh</span>
    <span class="console-mono text-xs text-[var(--console-muted)]">&copy; {year}</span>
  </div>
</footer>
