---
import { copy, localeConfig, type Locale } from "../data/landing";
import { guideRoutes } from "../data/guides";
import { changelogRoutes } from "../data/changelog";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].footer;
---

<footer class="ft">
  <div class="shell ft-in">
    <div class="ft-l">
      <a href={localeConfig[locale].route} class="ft-brand">
        <img src="/logo.svg?v=3" alt="" width="30" height="30" />
        <span>CodeSesh</span>
      </a>
      <span class="ft-note">{t.note}</span>
    </div>
    <nav
      class="ft-links"
      aria-label={localeConfig[locale].footerNavigationLabel}
    >
      <a href={changelogRoutes[locale]}>{t.changelog}</a>
      <a href={guideRoutes()[locale]}>{t.docs}</a>
      <a href="https://github.com/xingkaixin/codesesh/issues">{t.issues}</a>
      <a href="https://github.com/xingkaixin/codesesh">GitHub</a>
    </nav>
  </div>
</footer>

<style>
  .ft {
    padding: 44px 0 36px;
  }
  .ft-in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }
  .ft-l {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
  }
  .ft-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .ft-note {
    color: var(--muted);
    font-size: 12.5px;
  }
  .ft-links {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
  }
  .ft-links a {
    padding: 10px 11px;
    border-radius: 9px;
    color: var(--text-2);
    font-size: 12.5px;
  }
  .ft-links a:hover {
    background: var(--side-accent);
    color: var(--text);
  }
  @media (max-width: 760px) {
    .ft-in {
      flex-direction: column;
      align-items: flex-start;
    }
    .ft-links {
      margin-left: -11px;
    }
  }
</style>
