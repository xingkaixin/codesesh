}

const { locale } = Astro.props;
const t = experience[locale];
const tour = copy[locale].tour;
const scenes = copy[locale].scenes;
const s = sections[locale].tour;
const m = showcase[locale].tour;
const titles = showcase[locale].titles;
const sceneIds = ["overview", "projects", "replay"] as const;

const last7 = [38, 52, 61, 95, 74, 48, 44];
const last30 = [
  40,
  55,
  48,
  62,
  30,
  22,
  58,
  66,
  71,
  49,
  38,
  44,
  60,
  75,
  82,
  68,
  40,
  35,
  52,
  63,
  70,
  91,
  77,
