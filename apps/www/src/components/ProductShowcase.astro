---
import { experience } from "../data/experience";
import { copy, type Locale } from "../data/landing";
import { sections } from "../data/sections";
import { fill, showcase, splitTitle } from "../data/showcase";
import AgentIcon from "./AgentIcon.astro";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
