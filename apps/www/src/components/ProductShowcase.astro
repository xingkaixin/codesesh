---
import { copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";
import ProductDemo from "./ProductDemo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].tour;
---

<section class="border-y border-[var(--console-border)] bg-[var(--console-surface)] px-4 py-20 sm:px-6 md:py-24">
  <div class="mx-auto max-w-7xl">
    <p class="console-eyebrow text-[var(--brand)]">
      {t.label}
    </p>
    <h2 class="console-display landing-heading mt-3 max-w-2xl text-3xl font-semibold leading-tight text-[var(--console-text)] md:text-4xl">
      <HeadingText value={t.title} />
    </h2>
    <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--console-text-secondary)]">{t.body}</p>

    <div class="mt-12">
      <ProductDemo id={`tour-demo-${locale}`} locale={locale} />
    </div>
  </div>
</section>
