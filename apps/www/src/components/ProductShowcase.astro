<script>
  document.querySelectorAll<HTMLElement>("[data-tour]").forEach((tour) => {
    const tabs = [
      ...tour.querySelectorAll<HTMLButtonElement>("[data-tour-tab]"),
    ];
    const panels = [...tour.querySelectorAll<HTMLElement>("[data-tour-panel]")];
    let current = 0;
    let timer = 0;

    const select = (index: number, focus = false) => {
      current = index;
      tabs.forEach((tab, i) => {
        const active = i === index;
        tab.setAttribute("aria-selected", String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i]!.hidden = !active;
      });
      if (focus) tabs[index]!.focus();
    };

    const stopAuto = () => {
      window.clearInterval(timer);
      tour.dataset.auto = "off";
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const step =
          event.key === "ArrowRight" ? 1 : event.key === "ArrowLeft" ? -1 : 0;
        if (!step) return;
        event.preventDefault();
        select((index + step + tabs.length) % tabs.length, true);
      });
    });

    const tourBody = tour.querySelector<HTMLElement>(".tour");
    ["pointerenter", "focusin", "pointerdown"].forEach((type) =>
      tourBody?.addEventListener(type, stopAuto),
    );

    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver(
        ([entry]) => {
          if (!entry?.isIntersecting || tour.dataset.auto) return;
          observer.disconnect();
          tour.dataset.auto = "on";
          timer = window.setInterval(() => {
            if (!document.hidden) select((current + 1) % tabs.length);
          }, 9000);
        },
        { threshold: 0.35 },
      );
      observer.observe(tour);
    }

    const overview = tour.querySelector<HTMLElement>("[data-overview]");
    overview
      ?.querySelectorAll<HTMLButtonElement>("[data-range]")
      .forEach((button, _, buttons) => {
        button.addEventListener("click", () => {
          buttons.forEach((item) =>
            item.setAttribute("aria-pressed", String(item === button)),
          );
          overview
            .querySelectorAll<HTMLElement>("[data-range-view]")
            .forEach((view) => {
              view.hidden = view.dataset.rangeView !== button.dataset.range;
            });
        });
      });

    const projects = tour.querySelector<HTMLElement>("[data-projects]");
    if (projects) {
      const toggles =
        projects.querySelectorAll<HTMLButtonElement>("[data-sub-toggle]");
      const setButtons =
        projects.querySelectorAll<HTMLButtonElement>("[data-sub-set]");
      const setExpanded = (expanded: boolean) => {
        toggles.forEach((toggle) =>
          toggle.setAttribute("aria-expanded", String(expanded)),
        );
        setButtons.forEach((button) =>
          button.setAttribute(
            "aria-pressed",
            String(button.dataset.subSet === String(expanded)),
          ),
        );
        projects
          .querySelectorAll<HTMLElement>("[data-sub-row]")
          .forEach((row) => {
            row.hidden = !expanded;
          });
      };
      toggles.forEach((toggle) =>
        toggle.addEventListener("click", () =>
          setExpanded(toggle.getAttribute("aria-expanded") !== "true"),
        ),
      );
      setButtons.forEach((button) =>
        button.addEventListener("click", () =>
          setExpanded(button.dataset.subSet === "true"),
        ),
      );
    }

    const replay = tour.querySelector<HTMLElement>("[data-replay]");
    if (replay) {
      const status = replay.querySelector<HTMLElement>("[data-visible-status]");
      const filterButtons =
        replay.querySelectorAll<HTMLButtonElement>("[data-filter]");
      filterButtons.forEach((button) => {
        button.addEventListener("click", () => {
          button.setAttribute(
            "aria-pressed",
            String(button.getAttribute("aria-pressed") !== "true"),
          );
          const visible = new Set(
            [...filterButtons]
              .filter((item) => item.getAttribute("aria-pressed") === "true")
              .map((item) => item.dataset.filter),
          );
          let count = 0;
          replay
            .querySelectorAll<HTMLElement>("[data-step]")
            .forEach((step) => {
              step.hidden = !visible.has(step.dataset.step);
              if (!step.hidden) count += 1;
            });
          replay
            .querySelectorAll<HTMLElement>("[data-step-group]")
            .forEach((group) => {
              group.hidden = !group.querySelector("[data-step]:not([hidden])");
            });
          if (status) {
            status.textContent = (status.dataset.visibleTemplate ?? "").replace(
              "{count}",
              String(count),
            );
          }
        });
      });

      const toolToggle =
        replay.querySelector<HTMLButtonElement>("[data-tool-toggle]");
      const toolOutput =
        replay.querySelector<HTMLElement>("[data-tool-output]");
      toolToggle?.addEventListener("click", () => {
        const open = toolToggle.getAttribute("aria-expanded") !== "true";
        toolToggle.setAttribute("aria-expanded", String(open));
        if (toolOutput) toolOutput.hidden = !open;
      });
    }
  });
</script>

