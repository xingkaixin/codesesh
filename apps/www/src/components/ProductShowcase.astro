---
import { experience } from "../data/experience";
import { copy, type Locale } from "../data/landing";
import Icon from "./Icon.astro";
import ProductDemo from "./ProductDemo.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = experience[locale];
const scenes = ["overview", "projects", "replay"] as const;
---

<section
  id="tour"
  class="product-showcase section-space"
  aria-labelledby="tour-heading"
  data-showcase
>
  <div class="section-shell">
    <header class="showcase-heading" data-reveal>
      <h2 id="tour-heading" class="section-heading">
        {t.tourTitle}
      </h2>
      <p class="section-body">{t.tourBody}</p>
    </header>
    <div
      class="showcase-tabs"
      role="tablist"
      aria-label={copy[locale].header.tour}
    >
      {scenes.map((scene, index) => (
        <button
          type="button"
          role="tab"
          id={`tab-${scene}`}
          aria-controls={`tour-${scene}`}
          aria-selected={index === 0}
          tabindex={index === 0 ? 0 : -1}
        >
          <Icon
            name={
              index === 0
                ? "bar-chart-3"
                : index === 1
                  ? "list-tree"
                  : "terminal"
            }
          />
          {t.tabs[index]}
        </button>
      ))}
      <span class="showcase-sample">{copy[locale].tour.sampleLabel}</span>
    </div>
    <div class="showcase-stage">
      {scenes.map((scene, index) => (
        <div
          role="tabpanel"
          tabindex="0"
          id={`tour-${scene}`}
          aria-labelledby={`tab-${scene}`}
          hidden={index !== 0}
          class="showcase-panel"
        >
          <ProductDemo
            id={`tour-demo-${locale}-${scene}`}
            locale={locale}
            scene={scene}
          />
          <div class="showcase-description">
            <h3>{copy[locale].scenes[index]!.title}</h3>
            <p>{copy[locale].scenes[index]!.description}</p>
          </div>
          <p class="showcase-hint">
            <Icon name="arrow-right" />
            {copy[locale].scenes[index]!.hint}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<noscript>
  <style>
    .showcase-tabs {
      display: none;
    }
    .showcase-panel[hidden] {
      display: block;
    }
    .showcase-panel + .showcase-panel {
      margin-top: 3rem;
    }
  </style>
</noscript>

<script>
  const showcase = document.querySelector<HTMLElement>("[data-showcase]");
  if (showcase) {
    const tabs = Array.from(
      showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
    );
    const panels = Array.from(
      showcase.querySelectorAll<HTMLElement>('[role="tabpanel"]'),
    );
    function select(index: number) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
      });
      panels.forEach((panel, i) => {
        panel.hidden = i !== index;
      });
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", (event) => {
        const next =
          event.key === "ArrowRight"
            ? (index + 1) % tabs.length
            : event.key === "ArrowLeft"
              ? (index + tabs.length - 1) % tabs.length
              : event.key === "Home"
                ? 0
                : event.key === "End"
                  ? tabs.length - 1
                  : undefined;
        if (next === undefined) return;
        event.preventDefault();
        select(next);
        tabs[next]?.focus();
      });
    });
    function followHash() {
      const index = panels.findIndex(
        (panel) => `#${panel.id}` === window.location.hash,
      );
      if (index < 0) return;
      select(index);
      panels[index]?.scrollIntoView({ block: "start" });
    }
    followHash();
    window.addEventListener("hashchange", followHash);
  }
</script>

<style>
  .product-showcase {
    border-top: 1px solid var(--console-border);
    background: var(--console-surface-muted);
  }
  .showcase-heading {
    max-width: 48rem;
    margin-bottom: 2rem;
  }
  .showcase-tabs {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    border-bottom: 1px solid var(--console-border-strong);
  }
  .showcase-tabs button {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 3.75rem;
    padding: 0.6rem 0.15rem;
    color: var(--console-text-secondary);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
  }
  .showcase-tabs button::after {
    position: absolute;
    inset: auto 0 -1px;
    height: 2px;
    background: var(--brand-text);
    content: "";
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease-out);
  }
  .showcase-tabs button[aria-selected="true"] {
    color: var(--brand-text);
  }
  .showcase-tabs button[aria-selected="true"]::after {
    transform: scaleX(1);
  }
  .showcase-tabs button:hover {
    color: var(--console-text);
  }
  .showcase-sample {
    margin-left: auto;
    color: var(--console-muted);
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }
  .showcase-stage {
    padding: 2rem 0 0;
  }
  .showcase-panel {
    min-height: 38rem;
    scroll-margin-top: 8rem;
  }
  .showcase-description {
    margin-top: 1.6rem;
  }
  .showcase-description h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 550;
  }
  .showcase-description p {
    max-width: 68ch;
    margin: 0.5rem 0 0;
    color: var(--console-text-secondary);
    font-size: 0.87rem;
    line-height: 1.65;
  }
  .showcase-hint {
    display: flex;
    align-items: start;
    gap: 0.55rem;
    margin: 1.1rem 0 0;
    color: var(--console-text-secondary);
    font-size: 0.75rem;
    line-height: 1.6;
  }
  .showcase-hint :global(svg) {
    flex: 0 0 1rem;
    margin-top: 0.1rem;
  }
  @media (prefers-reduced-motion: no-preference) {
    .showcase-panel:not([hidden]) {
      animation: panel-enter 0.35s var(--ease-out);
    }
    @keyframes panel-enter {
      from {
        opacity: 0;
        transform: translateY(8px);
      }
    }
  }
  @media (max-width: 767px) {
    .showcase-heading {
      margin-bottom: 1.75rem;
    }
    .showcase-tabs {
      gap: 1.3rem;
    }
    .showcase-tabs button {
      font-size: 0.78rem;
      gap: 0.4rem;
    }
    .showcase-sample {
      display: none;
    }
    .showcase-stage {
      padding-top: 1.4rem;
    }
    .showcase-panel {
      min-height: 0;
    }
    .showcase-description p {
      font-size: 0.8rem;
    }
  }
</style>
