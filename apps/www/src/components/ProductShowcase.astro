];
const days30 = Array.from({ length: 30 }, (_, i) => {
  const date = new Date(Date.UTC(2026, 8, 16 + i));
  return i === 0 || i % 5 === 4 ? date.toISOString().slice(5, 10) : "";
});
const ranges = [
  {
    id: "7d",
    days: 7,
    from: "2026-10-09",
    to: "2026-10-15",
    short: "10-09 → 10-15",
    agents: 3,
    projects: 6,
    tokens: "412.6M",
    tokensPerDay: "58.9M",
    tokensDelta: "▲ 12%",
    cost: "$286.40",
    costPerDay: "$40.91",
    costDelta: "▲ 8%",
    sessions: "64",
    messages: "4,812",
    perSession: "75.2",
    sessionsDelta: "▼ 6%",
    mix: ["3.1M", "0.8%", "1.9M", "0.5%", "5.2M", "1.3%", "402.4M", "97.5%"],
    values: last7,
    sessionSeries: [8, 10, 9, 12, 11, 7, 7],
    labels: ["10-09", "10-10", "10-11", "10-12", "10-13", "10-14", "10-15"],
    gap: 16,
    showValues: true,
  },
  {
    id: "30d",
    days: 30,
    from: "2026-09-16",
    to: "2026-10-15",
    short: "09-16 → 10-15",
    agents: 4,
    projects: 9,
    tokens: "1.71B",
    tokensPerDay: "56.9M",
    tokensDelta: "▲ 21%",
    cost: "$1,185.52",
    costPerDay: "$39.52",
    costDelta: "▲ 17%",
    sessions: "251",
    messages: "19,307",
    perSession: "76.9",
    sessionsDelta: "▲ 4%",
    mix: ["12.9M", "0.8%", "8.2M", "0.5%", "22.4M", "1.3%", "1.66B", "97.5%"],
    values: last30,
    sessionSeries: last30.map((value, i) =>
      Math.round(value / 8 + ((i * 7) % 3)),
    ),
    labels: days30,
    gap: 4,
    showValues: false,
  },
  {
    id: "all",
    days: 0,
    from: "2025-11-02",
    to: "2026-10-15",
    short: "2025-11 → 2026-10",
    agents: 5,
    projects: 14,
    tokens: "6.94B",
    tokensPerDay: "19.9M",
    tokensDelta: m.all,
    cost: "$4,612.75",
    costPerDay: "$13.26",
    costDelta: m.all,
    sessions: "1,032",
    messages: "78,154",
    perSession: "75.7",
    sessionsDelta: m.all,
    mix: ["52.1M", "0.8%", "33.4M", "0.5%", "90.2M", "1.3%", "6.76B", "97.4%"],
    values: [210, 260, 330, 380, 450, 520, 560, 610, 690, 760, 1240, 930],
    sessionSeries: [34, 41, 50, 57, 66, 74, 80, 86, 95, 104, 162, 125],
    labels: m.months,
    gap: 12,
    showValues: false,
  },
];

function smooth(points: [number, number][]) {
  const f = (n: number) => n.toFixed(1);
  let d = `M${f(points[0]![0])},${f(points[0]![1])}`;
  for (let i = 0; i < points.length - 1; i++) {
    const p0 = points[i - 1] ?? points[i]!;
    const p1 = points[i]!;
    const p2 = points[i + 1]!;
    const p3 = points[i + 2] ?? p2;
    d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
  }
  return d;
}

function spark(values: number[]) {
  const max = Math.max(...values);
  const min = Math.min(...values);
  const points = values.map((v, i): [number, number] => [
    (i / (values.length - 1)) * 240,
    34 - ((v - min) / (max - min || 1)) * 28,
  ]);
  const line = smooth(points);
  return {
    line,
    area: `${line} L240,40 L0,40 Z`,
    endY: (points.at(-1)![1] / 40) * 100,
  };
}

const views = ranges.map((range, index) => {
  const n = range.values.length;
  const cost = range.values.map(
    (v, i) => v * 0.62 + ((i * 7) % 5) * (range.values[0]! / 20),
  );
  const vmax = Math.max(...range.values);
  const cmax = Math.max(...cost);
  const span = [
    `${range.from} – ${range.to}`,
    fill(m.agentsProjects, { agents: range.agents, projects: range.projects }),
    ...(range.days ? [fill(m.compare, { days: range.days })] : []),
  ].join(" · ");
  return {
    ...range,
    title: m.rangeTitles[index]!,
    span,
    kpis: [
      {
        key: "tokens",
        label: m.kpis[0],
        value: range.tokens,
        sub: `${fill(m.perDay, { value: range.tokensPerDay })} · ${fill(m.cacheHit, { value: "97%" })}`,
        delta: range.tokensDelta,
        estimate: false,
        ...spark(range.values),
      },
      {
        key: "cost",
        label: m.kpis[1],
        value: range.cost,
        sub: fill(m.perDay, { value: range.costPerDay }),
        delta: range.costDelta,
        estimate: true,
        ...spark(cost),
      },
      {
        key: "sessions",
        label: m.kpis[2],
        value: range.sessions,
        sub: fill(m.messagesPerSession, {
          messages: range.messages,
          perSession: range.perSession,
        }),
        delta: range.sessionsDelta,
        estimate: false,
        ...spark(range.sessionSeries),
      },
    ],
    bars: range.values.map((v, i) => ({
      height: ((v / vmax) * 82).toFixed(1),
      delay: Math.round(i * (n > 12 ? 16 : 50)),
      value: `${v}M`,
      label: range.labels[i],
    })),
    line: cost
      .map(
        (y, i) =>
          `${(((i + 0.5) / n) * 100).toFixed(2)},${(100 - (y / cmax) * 76 - 8).toFixed(2)}`,
      )
      .join(" "),
  };
});
const mixColors = ["var(--t-in)", "var(--t-out)", "var(--t-cw)"];
const mixWidths = ["1.4%", "1.1%", "2.2%"];

const tagColors = {
  fix: "var(--tg-bug)",
  test: "var(--tg-test)",
  refactor: "var(--tg-ref)",
  feature: "var(--tg-feat)",
  docs: "var(--tg-docs)",
  build: "var(--tg-build)",
};

type Tag = keyof typeof tagColors;

type Row =
  | { group: string }
  | {
      time: string;
      agent: string;
      title: string;
      messages: number;
      tokens: string;
      tags: Tag[];
      cost: string;
      subs?: number;
      sub?: boolean;
    };

const rows: Row[] = [
  { group: m.groups[0]! },
  {
    time: "14:22",
    agent: "Claude Code",
    title: titles.refresh,
    messages: 42,
    tokens: "6.1M",
    tags: ["fix", "test"],
    cost: "$4.12",
    subs: 2,
  },
  {
    time: "14:31",
    agent: "Claude Code",
    title: titles.middleware,
    messages: 9,
    tokens: "1.2M",
    tags: ["fix"],
    cost: "$0.61",
    sub: true,
  },
  {
    time: "14:48",
    agent: "Claude Code",
    title: titles.authTests,
    messages: 7,
    tokens: "0.8M",
    tags: ["test"],
    cost: "$0.38",
    sub: true,
  },
  {
    time: "11:05",
    agent: "Codex",
    title: titles.authRefactor,
    messages: 31,
    tokens: "4.4M",
    tags: ["refactor"],
    cost: "$2.86",
  },
  {
    time: "09:40",
    agent: "Cursor",
    title: titles.loginCopy,
    messages: 12,
    tokens: "0.9M",
    tags: ["feature", "docs"],
    cost: "$0.52",
  },
  { group: m.groups[1]! },
  {
    time: "18:12",
    agent: "Claude Code",
    title: titles.vite,
    messages: 26,
    tokens: "3.2M",
    tags: ["build"],
    cost: "$1.94",
  },
  {
    time: "15:30",
    agent: "Codex",
    title: titles.apiDocs,
    messages: 14,
    tokens: "1.1M",
    tags: ["docs"],
    cost: "$0.77",
  },
];
const projectValues = ["12", "486", "38.2M", "$24.60"];

const minimapColors = {
  u: "--tl-user",
  a: "--tl-agent",
  r: "--tl-read",
  w: "--tl-write",
  e: "--tl-exec",
};
const minimap =
  "u a r r e a r w w e a e e a w r e a u a r e w w e a r e a w e e a r a u"
    .split(" ")
    .map((key) => minimapColors[key as keyof typeof minimapColors]);
const tools = [
  { name: "bash", icon: "terminal", target: 'rg -n "refreshToken" src/auth' },
  { name: "read", icon: "file", target: "src/auth/middleware.ts" },
  { name: "edit", icon: "pencil", target: "src/auth/refresh.ts", diff: true },
] as const;
const filters = [
  { kind: "user", label: tour.userMessages, count: 1 },
  { kind: "agent", label: tour.agentResponses, count: 2 },
  { kind: "tool", label: tour.toolCalls, count: 4 },
];
const stepCount = filters.reduce((sum, filter) => sum + filter.count, 0);
---

<section id="tour" class="sec" aria-labelledby="tour-heading" data-tour>
  <div class="shell">
    <div class="sec-head" data-reveal>
      <div>
        <p class="eyebrow">
          <span class="n">01</span>
          <span class="ln"></span>
          {copy[locale].header.tour}
        </p>
        <h2 id="tour-heading" class="h2">
          <HeadingText value={splitTitle(t.tourTitle)} />
        </h2>
      </div>
      <p class="lead">{t.tourBody}</p>
    </div>

    <div class="tour">
      <div
        class="tabs tour__tabs"
        role="tablist"
        aria-label={copy[locale].header.tour}
      >
        {sceneIds.map((scene, index) => (
          <button
            type="button"
            role="tab"
            class="tab"
            id={`tour-tab-${scene}`}
            aria-controls={`tour-panel-${scene}`}
            aria-selected={index === 0 ? "true" : "false"}
            aria-labelledby={`tour-name-${scene}`}
            aria-describedby={`tour-desc-${scene}`}
            tabindex={index === 0 ? 0 : -1}
            data-tour-tab={scene}
          >
            <span class="tab-top">
              <span class="tab-n" aria-hidden="true">
                0{index + 1}
              </span>
              <span class="tab-name" id={`tour-name-${scene}`}>
                {t.tabs[index]}
              </span>
            </span>
            <span class="tab-t" id={`tour-desc-${scene}`}>
              {scenes[index]!.title}
              <span class="tab-more">
                <span class="tab-d">{scenes[index]!.description}</span>
                <span class="tab-h">
                  <Icon name="cursor" class="size-3.5" />
                  {scenes[index]!.hint}
                </span>
              </span>
            </span>
            <span class="tab-pg" aria-hidden="true"></span>
          </button>
        ))}
      </div>

      <div class="stagebox">
        <span class="sample">{tour.sampleLabel}</span>

        <div
          class="tour__scene"
          role="tabpanel"
          id="tour-panel-overview"
          aria-labelledby="tour-tab-overview"
          data-tour-panel="overview"
        >
          <div
            class="appp tour__window"
            aria-label={tour.overview}
            data-overview
          >
            <div class="a-head">
              <span class="cur">{showcase[locale].hero.nav[0]}</span>
              <span class="rt">
                {views.map((view) => (
                  <span
                    class="mono hide-sm a-short"
                    data-range-view={view.id}
                    hidden={view.id !== "7d"}
                  >
                    {view.short}
                  </span>
                ))}
                <span class="seg" role="group" aria-label={tour.range}>
                  {views.map((view, i) => (
                    <button
                      type="button"
                      class="seg-i"
                      aria-pressed={i === 0 ? "true" : "false"}
                      data-range={view.id}
                    >
                      {s.ranges[i]}
                    </button>
                  ))}
                </span>
              </span>
            </div>
            {views.map((view) => (
              <div
                class="ov"
                data-range-view={view.id}
                hidden={view.id !== "7d"}
              >
                <div>
                  <div class="ov-eb">{m.rangeEyebrow}</div>
                  <div class="ov-title">{view.title}</div>
                  <div class="ov-span">{view.span}</div>
                </div>
                <div class="kcard">
                  <div class="kpis">
                    {view.kpis.map((kpi) => (
                      <div class="kpi">
                        <div class="kpi-l">
                          {kpi.label}
                          {kpi.estimate && (
                            <span class="est">{m.estimate}</span>
                          )}
                          <span class="delta">{kpi.delta}</span>
                        </div>
                        <div class="kpi-v" data-stat={kpi.key}>
                          {kpi.value}
                        </div>
                        <div class="kpi-s">{kpi.sub}</div>
                        <div class="spark">
                          <svg
                            viewBox="0 0 240 40"
                            preserveAspectRatio="none"
                            aria-hidden="true"
                          >
                            <path class="ar" d={kpi.area} />
                            <path class="ln" d={kpi.line} />
                          </svg>
                          <span
                            class="dot"
                            style={`top:${kpi.endY.toFixed(1)}%`}
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                  <div class="comp">
                    <div class="row-sb">
                      <span class="ttl">{m.composition}</span>
                      <span class="mono comp-total">{view.tokens}</span>
                    </div>
                    <div class="comp-bar" aria-hidden="true">
                      {mixColors.map((color, i) => (
                        <i
                          style={`width:${mixWidths[i]};background:${color}`}
                        />
                      ))}
                      <i class="stripes" style="flex:1" />
                    </div>
                    <div class="comp-leg">
                      {m.tokenTypes.map((label, i) => (
                        <div class="leg">
                          <span
                            class:list={["sw", i === 3 && "stripes"]}
                            style={
                              i < 3 ? `background:${mixColors[i]}` : undefined
                            }
                          />
                          {label}
                          <b>
                            {view.mix[i * 2]}
                            <small>{view.mix[i * 2 + 1]}</small>
                          </b>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
                <div class="kcard daily">
                  <div class="row-sb daily-head">
                    <span class="ttl">{m.daily}</span>
                    <span class="legend">
                      {m.tokenTypes.map((label, i) => (
                        <span>
                          <span
                            class:list={["sw", i === 3 && "stripes"]}
                            style={
                              i < 3 ? `background:${mixColors[i]}` : undefined
                            }
                          />
                          {label}
                        </span>
                      ))}
                      <span>
                        <span class="lnk" />
                        {m.kpis[1]}
                      </span>
                    </span>
                  </div>
                  <div class="chart" style={`gap:${view.gap}px`}>
                    {view.bars.map((bar) => (
                      <div
                        class="bar stripes"
                        data-bar
                        style={`height:${bar.height}%;animation-delay:${bar.delay}ms`}
                      >
                        {view.showValues && <span class="bv">{bar.value}</span>}
                        <i class="b-cw" />
                        <i class="b-out" />
                        <i class="b-in" />
                      </div>
                    ))}
                    <svg
                      class="cline"
                      viewBox="0 0 100 100"
                      preserveAspectRatio="none"
                      aria-hidden="true"
                    >
                      <polyline pathLength="1" points={view.line} />
                    </svg>
                  </div>
                  <div class="xl" style={`gap:${view.gap}px`}>
                    {view.bars.map((bar) => (
                      <span>{bar.label}</span>
                    ))}
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>

        <div
          class="tour__scene"
          role="tabpanel"
          id="tour-panel-projects"
          aria-labelledby="tour-tab-projects"
          data-tour-panel="projects"
          hidden
        >
          <div
            class="appp tour__window"
            aria-label={tour.projects}
            data-projects
          >
            <div class="a-head">
              <span>{showcase[locale].hero.nav[0]}</span>
              <span class="sl">/</span>
              <span>{showcase[locale].hero.nav[1]}</span>
              <span class="sl">/</span>
              <span class="cur">web-app</span>
            </div>
            <div class="pj">
              <div class="pj-head">
                <div>
                  <div class="ov-eb">{m.project}</div>
                  <div class="ov-title">web-app</div>
                  <div class="ov-span">github.com/acme/web-app</div>
                </div>
                <div class="fchips">
                  <span class="fchip on">{m.allAgents}</span>
                  {[
                    ["Claude Code", 7],
                    ["Codex", 4],
                    ["Cursor", 1],
                  ].map(([agent, count]) => (
                    <span class="fchip">
                      <AgentIcon name={String(agent)} size={14} />
                      {agent} {count}
                    </span>
                  ))}
                </div>
              </div>
              <div class="mk">
                {m.projectStats.map(([label, sub], i) => (
                  <div class="kcard">
                    <div class="mk-l">
                      {label}
                      {i === 3 && <span class="est">{m.estimate}</span>}
                    </div>
                    <div class="mk-v">{projectValues[i]}</div>
                    <div class="mk-s">{sub}</div>
                  </div>
                ))}
              </div>
              <div class="kcard">
                <div class="tl-head">
                  <div>
                    <div class="ttl">{m.timeline}</div>
                    <div class="tl-sub">{m.timelineMeta}</div>
                  </div>
                  <div class="seg" role="group" aria-label={m.subSessions}>
                    <button
                      type="button"
                      class="seg-i"
                      aria-pressed="true"
                      data-sub-set="false"
                    >
                      {m.collapse}
                    </button>
                    <button
                      type="button"
                      class="seg-i"
                      aria-pressed="false"
                      data-sub-set="true"
                    >
                      {m.expandAll}
                    </button>
                  </div>
                </div>
                <div class="tscroll">
                  <table class="tbl">
                    <thead>
                      <tr>
                        <th class="w-time">{m.columns[0]}</th>
                        <th>{m.columns[1]}</th>
                        <th>{m.columns[2]}</th>
                        <th class="w-sub">{m.columns[3]}</th>
                        <th class="num w-cost">{m.columns[4]}</th>
                      </tr>
                    </thead>
                    <tbody>
                      {rows.map((row) =>
                        "group" in row ? (
                          <tr class="grp">
                            <td colspan="5">{row.group}</td>
                          </tr>
                        ) : (
                          <tr
                            class:list={[row.sub && "child"]}
                            hidden={row.sub}
                            data-sub-row={row.sub ? "" : undefined}
                          >
                            <td class="tm">{row.time}</td>
                            <td>
                              <div class="s-t">
                                {row.sub ? (
                                  <>
                                    <Icon
                                      name="chevron-right"
                                      class="size-3 sub-arrow"
                                    />
                                    <span class="subtag">sub</span>
                                  </>
                                ) : (
                                  <AgentIcon name={row.agent} />
                                )}
                                {row.title}
                              </div>
                              <div class="s-m">
                                {fill(m.rowMeta, {
                                  agent: row.sub
                                    ? fill(m.subAgent, { agent: row.agent })
                                    : row.agent,
                                  messages: row.messages,
                                  tokens: row.tokens,
                                })}
                              </div>
                            </td>
                            <td>
                              {row.tags.map((tag) => (
                                <span class="tag">
                                  <i style={`background:${tagColors[tag]}`} />
                                  {m.tags[tag]}
                                </span>
                              ))}
                            </td>
                            <td class="tm">
                              {row.subs ? (
                                <button
                                  type="button"
                                  class="subbtn"
                                  aria-expanded="false"
                                  aria-label={s.expand}
                                  data-sub-toggle
                                >
                                  <Icon name="chevron-right" class="size-3" />
                                  sub {row.subs}
                                </button>
                              ) : (
                                "—"
                              )}
                            </td>
                            <td class="num">
                              {row.subs ? (
                                <>
                                  <div data-rollup="cost">{row.cost}</div>
                                  <div class="rollup">{m.withSubs}</div>
                                </>
                              ) : (
                                row.cost
                              )}
                            </td>
                          </tr>
                        ),
                      )}
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div
          class="tour__scene"
          role="tabpanel"
          id="tour-panel-replay"
          aria-labelledby="tour-tab-replay"
          data-tour-panel="replay"
          hidden
        >
          <div class="appp tour__window" aria-label={tour.replay} data-replay>
            <div class="a-head">
              <span class="hide-sm">{showcase[locale].hero.nav[0]}</span>
              <span class="sl hide-sm">/</span>
              <span class="hide-sm">web-app</span>
              <span class="sl hide-sm">/</span>
              <span class="cur ellipsis">{titles.refresh}</span>
              <span class="rt">
                <span class="kbd hide-sm">Esc</span>
                <span class="mini-btn">
                  <Icon name="copy" class="size-3.5" />
                  {m.resume}
                </span>
              </span>
            </div>
            <div class="rp-head">
              <div class="ov-eb">{m.replayEyebrow}</div>
              <div class="rp-title">{titles.refresh}</div>
              <div class="rp-meta">
