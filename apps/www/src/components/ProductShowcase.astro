---
import { copy, type Locale } from "../data/landing";
import ProductDemo from "./ProductDemo.astro";
import SectionBackground from "./SectionBackground.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const sceneNames = ["overview", "projects", "replay"] as const;
const scenes = sceneNames.map((scene, index) => ({
  copy: copy[locale].scenes[index],
  scene,
}));
---

<div class="product-showcase">
  {
    scenes.map(({ copy: sceneCopy, scene }, index) => {
      const sectionId = index === 0 ? "tour" : `tour-${scene}`;
      const headingId = `${sectionId}-heading`;
      const descriptionId = `${sectionId}-description`;

      return (
        <section
          id={sectionId}
          class:list={[
            "showcase-section landing-background",
            `showcase-section--${scene}`,
          ]}
          aria-labelledby={headingId}
          aria-describedby={descriptionId}
        >
          {scene !== "overview" && <SectionBackground variant={scene} />}
          <div class="showcase-inner">
            <div class="showcase-grid">
              <div class="showcase-copy">
                <h2 id={headingId}>{sceneCopy?.title}</h2>
                <p id={descriptionId}>{sceneCopy?.description}</p>
              </div>

              <div class="showcase-preview">
                <ProductDemo
                  id={`tour-demo-${locale}-${scene}`}
                  locale={locale}
                  scene={scene}
                />
                <p class="showcase-hint">{sceneCopy?.hint}</p>
              </div>
            </div>
          </div>
        </section>
      );
    })
  }
</div>

<style>
  .product-showcase {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    overflow-x: clip;
    border-top: 1px solid var(--console-border);
    background: var(--console-bg);
  }

  .showcase-section {
    scroll-margin-top: 5rem;
    padding: 8rem 1.75rem;
  }

  .showcase-section--overview {
    background: var(--console-surface-sunken);
  }

  .showcase-inner {
    width: 100%;
    max-width: 73.75rem;
    min-width: 0;
    margin: 0 auto;
  }

  .showcase-grid {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(47.5rem, 1fr);
    gap: clamp(2rem, 3vw, 2.5rem);
    align-items: center;
  }

  .showcase-section--overview .showcase-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 2.4rem;
  }

  .showcase-section--overview .showcase-copy {
    max-width: 47rem;
  }

  .showcase-section--replay .showcase-grid {
    grid-template-columns: minmax(47.5rem, 1fr) minmax(0, 20rem);
  }

  .showcase-section--projects .showcase-copy h2,
  .showcase-section--replay .showcase-copy h2 {
    font-size: clamp(2rem, 3vw, 2.75rem);
  }

  .showcase-section--replay .showcase-copy {
    order: 2;
  }

  .showcase-section--replay .showcase-preview {
    order: 1;
  }

  .showcase-copy {
    min-width: 0;
  }

  .showcase-copy h2 {
    max-width: 13em;
    margin: 0;
    color: var(--console-text);
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.35rem);
    font-weight: 570;
    letter-spacing: -0.045em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .showcase-copy > p {
    max-width: 43ch;
    margin: 1.15rem 0 0;
    color: var(--console-text-secondary);
    font-size: 0.95rem;
    line-height: 1.75;
    text-wrap: pretty;
  }

  .showcase-preview {
    width: 100%;
    max-width: 100%;
    min-width: 0;
  }

  .showcase-hint {
    max-width: 45rem;
    margin: 0.85rem 0 0;
    color: var(--console-muted);
    font-family: var(--font-mono);
    font-size: 0.67rem;
    line-height: 1.65;
  }

  @media (max-width: 1180px) {
    .showcase-section {
      padding: 6rem 1.25rem;
    }

    .showcase-grid,
    .showcase-section--replay .showcase-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
    }

    .showcase-section--replay .showcase-copy,
    .showcase-section--replay .showcase-preview {
      order: initial;
    }

    .showcase-copy,
    .showcase-copy h2,
    .showcase-copy > p {
      max-width: 42rem;
    }
  }

  @media (max-width: 767px) {
    .showcase-section {
      padding: 4.75rem 1rem;
    }

    .showcase-grid,
    .showcase-section--overview .showcase-grid {
      gap: 1.6rem;
    }

    .showcase-copy h2 {
      font-size: clamp(1.8rem, 9vw, 2.45rem);
    }
  }
</style>
