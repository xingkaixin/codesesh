---
import { copy, localeConfig, locales, type Locale } from "../data/landing";
import { changelogRoutes } from "../data/changelog";
import { guideCopy, guideRoutes } from "../data/guides";
import Icon from "./Icon.astro";
import { experience } from "../data/experience";

interface Props {
  locale: Locale;
  page?: "landing" | "changelog" | "guides";
  languageRoutes?: Record<Locale, string>;
}

const { locale, page = "landing" } = Astro.props;
const t = copy[locale].header;
const homeRoute = localeConfig[locale].route;
const languageRoutes =
  Astro.props.languageRoutes ??
  (page === "changelog" ? changelogRoutes : undefined);

const links = [
  { label: t.tour, href: `${homeRoute}#tour` },
  { label: t.capabilities, href: `${homeRoute}#capabilities` },
  { label: t.agents, href: `${homeRoute}#agents` },
  { label: t.changelog, href: changelogRoutes[locale] },
  { label: guideCopy[locale].label, href: guideRoutes()[locale] },
  { label: t.faq, href: `${homeRoute}#faq` },
];
const themes = [
  { key: "light", icon: "sun", label: t.themeLight },
  { key: "dark", icon: "moon", label: t.themeDark },
  { key: "system", icon: "monitor", label: t.themeSystem },
] as const;
---

<header class="site-header">
  <div class="header-inner section-shell">
    <a href={homeRoute} class="site-brand">
      <img src="/logo.svg?v=3" alt="CodeSesh" width="28" height="28" />
      <span class="console-display">CODESESH</span>
    </a>
    <nav
      class="desktop-nav"
      aria-label={localeConfig[locale].primaryNavigationLabel}
    >
      {links.map((link) => (
        <a
          class="landing-nav-link"
          href={link.href}
          aria-current={Astro.url.pathname === link.href ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div
      class="header-controls"
      aria-label={localeConfig[locale].siteControlsLabel}
      role="group"
    >
      <div class="desktop-languages" role="group" aria-label={t.languageLabel}>
        {locales.map((item) => (
          <a
            href={languageRoutes?.[item] ?? localeConfig[item].route}
            aria-current={locale === item ? "page" : undefined}
            lang={localeConfig[item].language}
          >
            {localeConfig[item].switchLabel}
          </a>
        ))}
      </div>
      <button
        type="button"
        data-theme-toggle
        data-theme-label={t.themeLabel}
        data-theme-switch-to={t.themeSwitchTo}
        class="theme-control"
      >
        <span class="copy-icon-stack inline-grid">
          {themes.map((theme) => (
            <span
              data-theme-icon={theme.key}
              data-theme-text={theme.label}
              data-active={theme.key === "system" ? "true" : undefined}
            >
              <Icon name={theme.icon} class="size-4" />
            </span>
          ))}
        </span>
        <span
          class="sr-only"
          aria-live="polite"
          data-theme-status
        >{`${t.themeLabel}: ${t.themeSystem}${t.themeSwitchTo.replace("{next}", t.themeLight)}`}</span>
      </button>
      <a
        class="header-github"
        href="https://github.com/xingkaixin/codesesh"
        target="_blank"
        rel="noopener noreferrer"
      >
        {t.github}
        <Icon name="arrow-up-right" />
      </a>
      <details class="mobile-menu" data-mobile-menu>
        <summary>
          <span>{experience[locale].menu}</span>
          <Icon name="menu" />
        </summary>
        <div class="mobile-menu__panel">
          <nav aria-label={localeConfig[locale].primaryNavigationLabel}>
            {links.map((link) => (
              <a href={link.href}>
                {link.label}
                <Icon name="arrow-up-right" />
              </a>
            ))}
            <a
              href="https://github.com/xingkaixin/codesesh"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub
              <Icon name="arrow-up-right" />
            </a>
          </nav>
          <div
            class="mobile-languages"
            role="group"
            aria-label={t.languageLabel}
          >
            {locales.map((item) => (
              <a
                href={languageRoutes?.[item] ?? localeConfig[item].route}
                aria-current={locale === item ? "page" : undefined}
                lang={localeConfig[item].language}
              >
                {localeConfig[item].switchLabel}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--console-border);
    background: color-mix(in srgb, var(--console-bg) 94%, transparent);
    backdrop-filter: blur(16px);
  }
  .header-inner {
    display: flex;
    height: 76px;
    align-items: center;
    gap: 2rem;
  }
  .site-brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    flex-shrink: 0;
  }
  .site-brand span {
    font-size: 0.91rem;
    font-weight: 700;
    letter-spacing: 0.045em;
  }
  .desktop-nav {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    margin-left: auto;
  }
  .desktop-nav a {
    white-space: nowrap;
    font-size: 0.76rem;
    padding-block: 0.75rem;
  }
  .header-controls {
    display: flex;
    gap: 0.65rem;
    align-items: center;
    margin-left: auto;
  }
  .desktop-languages,
  .mobile-languages {
    display: flex;
    align-items: center;
    gap: 0.85rem;
  }
  .desktop-languages a,
  .mobile-languages a {
    color: var(--console-text-secondary);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    padding-block: 0.75rem;
  }
  [aria-current="page"] {
    color: var(--console-text);
    text-decoration: underline;
    text-underline-offset: 5px;
  }
  .theme-control {
    display: grid;
    place-items: center;
    width: 40px;
    height: 44px;
    cursor: pointer;
    color: var(--console-text-secondary);
  }
  .theme-control:hover {
    color: var(--brand-text);
  }
  .header-github {
    display: flex;
    gap: 0.6rem;
    align-items: center;
    min-height: 40px;
    padding-inline: 0.9rem;
    border: 1px solid var(--console-border-strong);
    border-radius: var(--radius-sm);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .header-github:hover {
    background: var(--console-surface);
  }
  .mobile-menu {
    display: none;
  }
  @media (max-width: 1279px) {
    .desktop-nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .mobile-menu summary {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      min-height: 44px;
      padding-inline: 0.5rem;
      cursor: pointer;
      list-style: none;
      font-size: 0.78rem;
    }
    .mobile-menu summary::-webkit-details-marker {
      display: none;
    }
    .mobile-menu__panel {
      position: absolute;
      inset: 100% 0 auto;
      padding: 1.25rem max(1.25rem, calc((100vw - 80rem) / 2)) 1.5rem;
      border-bottom: 1px solid var(--console-border-strong);
      background: var(--console-bg);
      box-shadow: var(--elevation-overlay);
      max-height: calc(100dvh - 76px);
      overflow-y: auto;
    }
    .mobile-menu__panel nav {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.2rem 2rem;
    }
    .mobile-menu__panel nav a {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: 48px;
      font-size: 1rem;
    }
    .mobile-languages {
      margin-top: 1rem;
      padding-top: 0.65rem;
      border-top: 1px solid var(--console-border);
      gap: 1.5rem;
    }
    .mobile-languages a {
      font-size: 0.78rem;
    }
  }
  @media (max-width: 767px) {
    .header-inner {
      height: 68px;
      gap: 0.5rem;
    }
    .desktop-languages,
    .header-github {
      display: none;
    }
    .header-controls {
      gap: 0.2rem;
    }
    .site-brand span {
      font-size: 0.82rem;
    }
    .site-brand {
      gap: 0.55rem;
    }
    .site-brand img {
      width: 25px;
      height: 25px;
    }
    .mobile-menu__panel {
      max-height: calc(100dvh - 68px);
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .site-header {
      background: var(--console-bg);
      backdrop-filter: none;
    }
  }
</style>

<script>
  import { attachFluidHover } from "../../../shared/fluid-hover";

  function setupFluidHover() {
    const cleanups = Array.from(
      document.querySelectorAll<HTMLElement>("[data-fluid-hover]"),
      attachFluidHover,
    );
    document.addEventListener(
      "astro:before-swap",
      () => cleanups.forEach((cleanup) => cleanup()),
      { once: true },
    );
  }

  setupFluidHover();
  document.addEventListener("astro:after-swap", setupFluidHover);

  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      if (
        !menu.contains(event.target) ||
        (event.target instanceof Element && event.target.closest("a"))
      )
        menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  }

  const THEMES = ["light", "dark", "system"] as const;

  type Theme = (typeof THEMES)[number];

  const NEXT_THEME: Record<Theme, Theme> = {
    light: "dark",
    dark: "system",
    system: "light",
  };

  function isTheme(value: string | undefined): value is Theme {
    return !!value && (THEMES as readonly string[]).includes(value as Theme);
  }

  declare global {
    interface Window {
      __wwwTheme?: { get: () => Theme; set: (next: Theme) => void };
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      const label = button.dataset.themeLabel ?? "";
      const switchToTemplate = button.dataset.themeSwitchTo ?? "";
      const status = button.querySelector<HTMLElement>("[data-theme-status]");
      const icons = new Map<Theme, HTMLElement>();
      button
        .querySelectorAll<HTMLElement>("[data-theme-icon]")
        .forEach((el) => {
          const key = el.dataset.themeIcon;
          if (isTheme(key)) icons.set(key, el);
        });

      function render(theme: Theme) {
        icons.forEach((el, key) => {
          el.dataset.active = String(key === theme);
        });
        const currentText = icons.get(theme)?.dataset.themeText ?? "";
        const nextText = icons.get(NEXT_THEME[theme])?.dataset.themeText ?? "";
        const switchToText = switchToTemplate.replace("{next}", nextText);
        if (status)
          status.textContent = `${label}: ${currentText}${switchToText}`;
      }

      render(window.__wwwTheme?.get() ?? "system");

      button.addEventListener("click", () => {
        const current = window.__wwwTheme?.get() ?? "system";
        const nextTheme = NEXT_THEME[current];
        window.__wwwTheme?.set(nextTheme);
        render(nextTheme);
      });
    });
</script>
