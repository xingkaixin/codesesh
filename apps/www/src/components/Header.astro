---
import { copy, localeConfig, locales, type Locale } from "../data/landing";
import { changelogCopy, changelogRoutes } from "../data/changelog";
import { guideCopy, guideRoutes } from "../data/guides";
import Icon from "./Icon.astro";
import { experience } from "../data/experience";

interface Props {
  locale: Locale;
  page?: "landing" | "changelog" | "guides";
  languageRoutes?: Record<Locale, string>;
}

const { locale, page = "landing" } = Astro.props;
const t = copy[locale].header;
const homeRoute = localeConfig[locale].route;
const version = changelogCopy[locale].releases[0]!.version;
const languageRoutes =
  Astro.props.languageRoutes ??
  (page === "changelog" ? changelogRoutes : undefined);

const links = [
  { label: t.tour, href: `${homeRoute}#tour` },
  { label: t.capabilities, href: `${homeRoute}#capabilities` },
  { label: t.hub, href: `${homeRoute}#hub` },
  { label: t.agents, href: `${homeRoute}#agents` },
  { label: t.changelog, href: changelogRoutes[locale], page: "changelog" },
  {
    label: guideCopy[locale].label,
    href: guideRoutes()[locale],
    page: "guides",
  },
  { label: t.faq, href: `${homeRoute}#faq` },
];
const themes = [
  { key: "light", icon: "sun", label: t.themeLight },
  { key: "dark", icon: "moon", label: t.themeDark },
  { key: "system", icon: "monitor", label: t.themeSystem },
] as const;
---

<header class="hdr">
  <div class="shell hdr-in">
    <a href={homeRoute} class="brand">
      <img src="/logo.svg?v=3" alt="" width="30" height="30" />
      <span>CodeSesh</span>
      <span class="ver">v{version}</span>
    </a>
    <nav class="nav" aria-label={localeConfig[locale].primaryNavigationLabel}>
      {links.map((link) => (
        <a
          href={link.href}
          aria-current={link.page === page ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>
    <div
      class="hdr-tools"
      aria-label={localeConfig[locale].siteControlsLabel}
      role="group"
    >
      <div
        class="lang desktop-languages"
        role="group"
        aria-label={t.languageLabel}
      >
        {locales.map((item) => (
          <a
            href={languageRoutes?.[item] ?? localeConfig[item].route}
            aria-current={locale === item ? "page" : undefined}
            lang={localeConfig[item].language}
          >
            {localeConfig[item].switchLabel}
          </a>
        ))}
      </div>
      <button
        type="button"
        data-theme-toggle
        data-theme-label={t.themeLabel}
        data-theme-switch-to={t.themeSwitchTo}
        class="icon-btn"
      >
        <span class="copy-icon-stack">
          {themes.map((theme) => (
            <span
              data-theme-icon={theme.key}
              data-theme-text={theme.label}
              data-active={theme.key === "system" ? "true" : undefined}
            >
              <Icon name={theme.icon} />
            </span>
          ))}
        </span>
        <span
          class="sr-only"
          aria-live="polite"
          data-theme-status
        >{`${t.themeLabel}: ${t.themeSystem}${t.themeSwitchTo.replace("{next}", t.themeLight)}`}</span>
      </button>
      <a
        class="gh"
        href="https://github.com/xingkaixin/codesesh"
        target="_blank"
        rel="noopener noreferrer"
      >
        <Icon name="github" />
        <span>{t.github}</span>
      </a>
      <details class="mobile-menu" data-mobile-menu>
        <summary class="icon-btn" aria-label={experience[locale].menu}>
          <Icon name="menu" />
        </summary>
        <div class="mnav">
          <nav aria-label={localeConfig[locale].primaryNavigationLabel}>
            {links.map((link) => (
              <a
                href={link.href}
                aria-current={link.page === page ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <div class="mlang" role="group" aria-label={t.languageLabel}>
            {locales.map((item) => (
              <a
                href={languageRoutes?.[item] ?? localeConfig[item].route}
                aria-current={locale === item ? "page" : undefined}
                lang={localeConfig[item].language}
              >
                {localeConfig[item].switchLabel}
              </a>
            ))}
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: sticky;
    top: 0;
    z-index: 30;
    background: color-mix(in oklab, var(--frame) 88%, transparent);
    backdrop-filter: blur(14px);
  }
  .hdr-in {
    display: flex;
    align-items: center;
    gap: 20px;
    height: 68px;
  }
  .brand {
    display: flex;
    flex: none;
    align-items: center;
    gap: 10px;
    color: var(--text);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .brand img {
    width: 30px;
    height: 30px;
  }
  .ver {
    padding: 4px 6px;
    border-radius: 6px;
    background: var(--side-accent);
    color: var(--muted);
    font: 500 11px/1 var(--mono);
  }
  .nav {
    display: flex;
    gap: 2px;
    margin-left: 16px;
  }
  .nav a {
    padding: 9px 12px;
    border-radius: 9px;
    color: var(--text-2);
    font-size: 13px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .nav a:hover,
  .nav a[aria-current="page"] {
    background: var(--side-accent);
    color: var(--text);
  }
  .hdr-tools {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-left: auto;
  }
  .lang {
    display: flex;
    padding: 3px;
    border-radius: 11px;
    background: var(--side-accent);
  }
  .lang a {
    padding: 7px 10px;
    border-radius: 8px;
    color: var(--muted);
    font-size: 11.5px;
    font-weight: 600;
  }
  .lang a:hover {
    color: var(--text);
  }
  .lang a[aria-current="page"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--sh-raised);
  }
  .icon-btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    color: var(--text-2);
    cursor: pointer;
    transition:
      background 0.15s,
      color 0.15s;
  }
  .icon-btn:hover {
    background: var(--side-accent);
    color: var(--text);
  }
  .gh {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--ink);
    color: var(--ink-fg);
    font-size: 13px;
    font-weight: 600;
  }
  .gh:hover {
    opacity: 0.9;
  }
  .mobile-menu {
    display: none;
  }
  .mobile-menu summary {
    list-style: none;
  }
  .mobile-menu summary::-webkit-details-marker {
    display: none;
  }
  .mnav {
    position: absolute;
    top: 100%;
    right: 16px;
    left: 16px;
    max-height: calc(100dvh - 80px);
    overflow-y: auto;
    padding: 8px;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: var(--surface);
    box-shadow: var(--sh-overlay);
  }
  .mnav nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .mnav a {
    padding: 12px 14px;
    border-radius: 10px;
    color: var(--text-2);
    font-weight: 500;
  }
  .mnav a:hover,
  .mnav a[aria-current="page"] {
    background: var(--muted-bg);
    color: var(--text);
  }
  .mlang {
    display: flex;
    gap: 2px;
    margin-top: 6px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
  }
  .mlang a {
    flex: 1;
    text-align: center;
    font-size: 13px;
  }
  @media (max-width: 1180px) {
    .nav {
      display: none;
    }
    .mobile-menu {
      display: block;
    }
    .icon-btn {
      width: 44px;
      height: 44px;
    }
  }
  @media (max-width: 760px) {
    .lang {
      display: none;
    }
    .gh span {
      display: none;
    }
    .gh {
      height: 44px;
      padding: 0 12px;
    }
  }
  @media (prefers-reduced-transparency: reduce) {
    .hdr {
      background: var(--frame);
      backdrop-filter: none;
    }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (!(event.target instanceof Node)) return;
      if (
        !menu.contains(event.target) ||
        (event.target instanceof Element && event.target.closest("a"))
      )
        menu.open = false;
    });
    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || !menu.open) return;
      menu.open = false;
      menu.querySelector("summary")?.focus();
    });
  }

  const THEMES = ["light", "dark", "system"] as const;

  type Theme = (typeof THEMES)[number];

  const NEXT_THEME: Record<Theme, Theme> = {
    light: "dark",
    dark: "system",
    system: "light",
  };

  function isTheme(value: string | undefined): value is Theme {
    return !!value && (THEMES as readonly string[]).includes(value as Theme);
  }

  declare global {
    interface Window {
      __wwwTheme?: { get: () => Theme; set: (next: Theme) => void };
    }
  }

  document
    .querySelectorAll<HTMLButtonElement>("[data-theme-toggle]")
    .forEach((button) => {
      const label = button.dataset.themeLabel ?? "";
      const switchToTemplate = button.dataset.themeSwitchTo ?? "";
      const status = button.querySelector<HTMLElement>("[data-theme-status]");
      const icons = new Map<Theme, HTMLElement>();
      button
        .querySelectorAll<HTMLElement>("[data-theme-icon]")
        .forEach((el) => {
          const key = el.dataset.themeIcon;
          if (isTheme(key)) icons.set(key, el);
        });

      function render(theme: Theme) {
        icons.forEach((el, key) => {
          el.dataset.active = String(key === theme);
        });
        const currentText = icons.get(theme)?.dataset.themeText ?? "";
        const nextText = icons.get(NEXT_THEME[theme])?.dataset.themeText ?? "";
        const switchToText = switchToTemplate.replace("{next}", nextText);
        if (status)
          status.textContent = `${label}: ${currentText}${switchToText}`;
      }

      render(window.__wwwTheme?.get() ?? "system");

      button.addEventListener("click", () => {
        const current = window.__wwwTheme?.get() ?? "system";
        const nextTheme = NEXT_THEME[current];
        window.__wwwTheme?.set(nextTheme);
        render(nextTheme);
      });
    });
</script>
