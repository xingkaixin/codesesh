---
import { copy, type Locale } from "../data/landing";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].features;
const [title, subtitle] = Array.isArray(t.title) ? t.title : [t.title, ""];
---

<section
  id="capabilities"
  class="features section-space"
  aria-labelledby="features-heading"
>
  <div class="section-shell">
    <header class="features__header" data-reveal>
      <p class="landing-kicker">
        <b>02</b>
        {copy[locale].header.capabilities}
      </p>
      <h2 id="features-heading" class="section-heading">
        {title}
        {subtitle && <span>{subtitle}</span>}
      </h2>
      <p class="section-body">{t.body}</p>
    </header>

    <div class="features__track" aria-hidden="true">
      <span></span>
    </div>
    <ol class="features__grid">
      {t.groups.map((group, index) => (
        <li class="features__stage" data-reveal>
          <span
            class="features__number console-display"
            style={`animation-delay:${index * 2}s`}
            aria-hidden="true"
          >
            0{index + 1}
          </span>
          <h3 class="console-display">{group.title}</h3>
          <p class="features__description">{group.description}</p>
          <ul>
            {group.items.map((item) => (
              <li>
                <h4>{item.title}</h4>
                <p>{item.description}</p>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .features {
    scroll-margin-top: 4rem;
  }
  .features__header {
    max-width: 54rem;
  }
  .features__header h2 span {
    display: block;
    color: var(--console-muted);
  }
  .features__track {
    position: relative;
    height: 2px;
    margin: 4rem 0 2.25rem;
    background: var(--console-border-strong);
  }
  .features__track span {
    position: absolute;
    top: -5px;
    left: 0;
    width: 12px;
    height: 12px;
    border-radius: 99px;
    background: var(--signal);
    box-shadow: 0 0 0 6px var(--signal-soft);
    animation: features-travel 8s linear infinite;
  }
  .features__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features__stage {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }
  .features__number {
    color: var(--console-border-strong);
    font-size: 3.5rem;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
    animation: features-lit 8s linear infinite;
  }
  .features__stage h3 {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 600;
  }
  .features__description {
    min-height: 2.75rem;
    margin: 0 0 0.5rem;
    color: var(--console-text-secondary);
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .features__stage ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .features__stage ul li {
    padding: 0.9rem 0;
    border-top: 1px solid var(--console-border);
  }
  .features__stage h4 {
    margin: 0;
    font-size: 0.94rem;
    font-weight: 600;
  }
  .features__stage ul p {
    margin: 0.35rem 0 0;
    color: var(--console-muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  @keyframes features-travel {
    from {
      left: 0;
    }
    to {
      left: calc(100% - 12px);
    }
  }
  /* 8s 周期内数字只在光点经过时亮起，四列依次延迟 2s 与光点位置对齐。 */
  @keyframes features-lit {
    0%,
    4% {
      color: var(--signal);
    }
    18%,
    100% {
      color: var(--console-border-strong);
    }
  }

  @media (max-width: 1023px) {
    .features__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 3rem;
    }
    .features__track {
      display: none;
    }
    .features__grid {
      margin-top: 3rem;
    }
    .features__number {
      animation: none;
      color: var(--brand-text);
    }
  }
  @media (max-width: 639px) {
    .features__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .features__track span {
      animation: none;
    }
    .features__number {
      animation: none;
      color: var(--brand-text);
    }
  }
</style>
