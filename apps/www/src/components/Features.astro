---
import { copy, type Locale } from "../data/landing";
import HeadingText from "./HeadingText.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = copy[locale].features;
---

<section
  id="capabilities"
  class="scroll-mt-20 px-4 pb-4 pt-24 sm:px-6 sm:pt-28 lg:px-7"
  aria-labelledby="capabilities-heading"
>
  <div class="mx-auto max-w-[1180px]">
    <h2
      id="capabilities-heading"
      class="console-display landing-heading max-w-[20em] text-3xl font-semibold leading-[1.16] text-[var(--console-text)] sm:text-[2.15rem]"
    >
      <HeadingText value={t.title} />
    </h2>
    <p
      class="mt-4 max-w-2xl text-sm leading-7 text-[var(--console-text-secondary)]"
    >
      {t.body}
    </p>

    <div
      class="mt-9 grid gap-px overflow-hidden rounded-lg border border-[var(--console-border)] bg-[var(--console-border)] sm:grid-cols-2 lg:grid-cols-4"
    >
      {
        t.groups.map((group) => (
          <article class="bg-[var(--console-bg)] px-5 py-6 sm:px-6">
            <h3 class="console-display text-xl font-semibold text-[var(--console-text)]">
              {group.title}
            </h3>
            <p class="mt-2 min-h-12 text-xs leading-5 text-[var(--console-muted)]">
              {group.description}
            </p>
            <ul class="mt-5 space-y-4">
              {group.items.map((item) => (
                <li>
                  <p class="text-[13px] font-semibold text-[var(--console-text)]">
                    {item.title}
                  </p>
                  <p class="mt-1 text-xs leading-5 text-[var(--console-text-secondary)]">
                    {item.description}
                  </p>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>
