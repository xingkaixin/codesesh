---
import {
  changelogCopy,
  changelogRoutes,
  formatReleaseDate,
} from "../data/changelog";
import type { Locale } from "../data/landing";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = changelogCopy[locale];
const release = t.releases[0]!;
---

<section
  id="updates"
  class="latest-update"
  aria-labelledby="updates-heading"
  data-reveal
>
  <div class="release-meta">
    <span>{t.latest.label}</span>
    <time datetime={release.date}>
      {formatReleaseDate(locale, release.date)}
    </time>
  </div>
  <h2 id="updates-heading" class="console-display">
    {release.title}
  </h2>
  <p>{release.summary}</p>
  <a class="text-link" href={changelogRoutes[locale]}>
    {t.latest.link}
    <Icon name="arrow-right" />
  </a>
</section>
<style>
  .latest-update {
    padding: 2.6rem;
    background: var(--console-surface);
    border: 1px solid var(--console-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--elevation-raised);
    scroll-margin-top: 6rem;
  }
  .release-meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--console-text-secondary);
  }
  .latest-update h2 {
    max-width: 16em;
    margin: 2rem 0 1rem;
    font-size: clamp(1.7rem, 2.2vw, 2.2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .latest-update > p {
    margin: 0 0 1.5rem;
    font-size: 0.9rem;
    line-height: 1.75;
    color: var(--console-text-secondary);
  }
  @media (max-width: 767px) {
    .latest-update {
      padding: 1.5rem;
    }
  }
</style>
