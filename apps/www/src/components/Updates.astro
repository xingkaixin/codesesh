---
import { changelogCopy, changelogRoutes } from "../data/changelog";
import { guideCopy, guideRoutes, guides } from "../data/guides";
import type { Locale } from "../data/landing";
import { splitTitle } from "../data/showcase";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = changelogCopy[locale];
const g = guideCopy[locale];
const release = t.releases[0]!;
---

<section id="updates" class="sec" aria-labelledby="updates-heading">
  <div class="shell">
    <div class="sec-head" data-reveal>
      <div>
        <h2 id="updates-heading" class="h2">
          <HeadingText value={splitTitle(t.latest.title)} />
        </h2>
      </div>
    </div>
    <div class="res">
      <article class="upd" data-reveal aria-labelledby="latest-release">
        <div class="upd-meta">
          <span>{t.latest.label}</span>
          <span class="vtag">v{release.version}</span>
          <time datetime={release.date}>{release.date}</time>
        </div>
        <h3 id="latest-release">{release.title}</h3>
        <p>{release.summary}</p>
        <ul class="hl-list">
          {release.highlights.map((item) => (
            <li class="hl-i">
              <span class="ck2">
                <Icon name="check" />
              </span>
              {item.title}
            </li>
          ))}
        </ul>
        <a class="tlink" href={changelogRoutes[locale]}>
          {t.latest.link}
          <Icon name="arrow" />
        </a>
      </article>
      <nav class="guides" data-reveal aria-labelledby="guides-heading">
        <h3 class="g-h" id="guides-heading">
          <Icon name="book" />
          {g.title}
        </h3>
        <ol>
          {guides.map((guide, index) => (
            <li>
              <a class="g-i" href={guideRoutes(guide.slug)[locale]}>
                <span class="gn">0{index + 1}</span>
                <span class="g-t">{guide.copy[locale].title}</span>
                <Icon name="arrow" class="size-4 arr" />
              </a>
            </li>
          ))}
        </ol>
        <a class="tlink g-all" href={guideRoutes()[locale]}>
          {g.all}
          <Icon name="arrow" />
        </a>
      </nav>
    </div>
  </div>
</section>

<style>
  .res {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: 20px;
  }
  .upd,
  .guides {
    border: 1px solid var(--border);
    border-radius: 22px;
    background: var(--surface);
    box-shadow: var(--sh-raised);
  }
  .upd {
    position: relative;
    overflow: hidden;
    padding: 36px;
  }
  .upd::after {
    position: absolute;
    top: -60px;
    right: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: repeating-linear-gradient(
      -45deg,
      var(--brand-line) 0 2px,
      transparent 2px 9px
    );
    content: "";
    opacity: 0.8;
    pointer-events: none;
  }
  .upd-meta {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px;
    color: var(--muted);
    font: 500 11px/1 var(--mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .vtag {
    padding: 5px 9px;
    border: 1px solid var(--brand-line);
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-ink);
    font: 600 11px/1 var(--mono);
    letter-spacing: 0;
    text-transform: none;
  }
  .upd h3 {
    position: relative;
    z-index: 1;
    max-width: 520px;
    margin: 22px 0 0;
    font-size: 27px;
    font-weight: 300;
    line-height: 1.35;
    letter-spacing: -0.015em;
  }
  .upd p {
    max-width: 560px;
    margin: 14px 0 0;
    color: var(--text-2);
    font-size: 14px;
    line-height: 1.8;
  }
  .hl-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin: 24px 0 28px;
    padding: 0;
    list-style: none;
  }
  .hl-i {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    line-height: 1.5;
  }
  .ck2 {
    display: grid;
    flex: none;
    place-items: center;
    width: 22px;
    height: 22px;
    border-radius: 7px;
    background: var(--pos-soft);
    color: var(--pos-ink);
  }
  .ck2 :global(svg) {
    width: 12px;
    height: 12px;
  }
  .guides {
    display: flex;
    flex-direction: column;
    padding: 30px;
  }
  .g-h {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0 0 12px;
    font-size: 16px;
    font-weight: 600;
  }
  .g-h :global(svg) {
    color: var(--brand-ink);
  }
  .guides ol {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .g-i {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 15px 4px;
    border-top: 1px solid var(--border);
    border-radius: 2px;
    color: var(--text);
    font-size: 13.5px;
    font-weight: 500;
    transition: background 0.15s;
  }
  .g-i:hover {
    background: var(--muted-bg);
  }
  .gn {
    flex: none;
    width: 22px;
    color: var(--muted);
    font: 500 11px/1 var(--mono);
  }
  .g-t {
    flex: 1;
    min-width: 0;
  }
  .g-i :global(.arr) {
    flex: none;
    color: var(--muted);
    transition: transform 0.2s var(--ease-out);
  }
  .g-i:hover :global(.arr) {
    color: var(--brand-ink);
    transform: translateX(3px);
  }
  .g-all {
    margin-top: 18px;
  }
  @media (max-width: 900px) {
    .res {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 760px) {
    .hl-list {
      grid-template-columns: minmax(0, 1fr);
    }
    .upd,
    .guides {
      padding: 24px;
    }
  }
</style>
