---
import {
  BookmarkIcon,
  ChartColumnIcon,
  CheckIcon,
  ChevronLeftIcon,
  ChevronRightIcon,
  ComputerIcon,
  CopyIcon,
  DatabaseIcon,
  ExpandIcon,
  EyeIcon,
  KeyboardIcon,
  ListTreeIcon,
  MoonIcon,
  Search01Icon,
  SettingsIcon,
  ShieldIcon,
  SunIcon,
  TagsIcon,
  TerminalIcon,
  TimerIcon,
} from "@hugeicons/core-free-icons";
import type { IconName } from "../data/landing";

type UiIconName =
  | IconName
  | "check"
  | "chevron-left"
  | "chevron-right"
  | "copy"
  | "expand"
  | "sun"
  | "moon"
  | "monitor";

interface Props {
  name: UiIconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;

const icons = {
  "bar-chart-3": ChartColumnIcon,
  bookmark: BookmarkIcon,
  check: CheckIcon,
  "chevron-left": ChevronLeftIcon,
  "chevron-right": ChevronRightIcon,
  copy: CopyIcon,
  database: DatabaseIcon,
  expand: ExpandIcon,
  eye: EyeIcon,
  keyboard: KeyboardIcon,
  "list-tree": ListTreeIcon,
  monitor: ComputerIcon,
  moon: MoonIcon,
  search: Search01Icon,
  settings: SettingsIcon,
  shield: ShieldIcon,
  sun: SunIcon,
  tags: TagsIcon,
  terminal: TerminalIcon,
  timer: TimerIcon,
} satisfies Record<UiIconName, unknown>;

// Hugeicons 的图形数据用 React 风格的 camelCase 属性，渲染原生 SVG 需转成 kebab-case。
const body = icons[name]
  .map(([tag, attrs]) => {
    const rendered = Object.entries(attrs)
      .filter(([key]) => key !== "key")
      .map(([key, value]) => `${key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}="${value}"`)
      .join(" ");
    return `<${tag} ${rendered}/>`;
  })
  .join("");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <Fragment set:html={body} />
</svg>
