---
import {
  ArrowDown01Icon,
  ArrowMoveDownRightIcon,
  ArrowRight01Icon,
  ArrowRight02Icon,
  ArrowUpRight01Icon,
  BookmarkIcon,
  BookOpen01Icon,
  Cancel01Icon,
  ChartColumnIcon,
  CheckIcon,
  ChevronLeftIcon,
  ChevronRightIcon,
  CloudOffIcon,
  Compass01Icon,
  ComputerIcon,
  CopyIcon,
  Cursor01Icon,
  DashboardSquare01Icon,
  DatabaseIcon,
  ExpandIcon,
  EyeIcon,
  File01Icon,
  Folder01Icon,
  GithubIcon,
  HierarchySquare02Icon,
  InformationCircleIcon,
  KeyboardIcon,
  LaptopIcon,
  ListTreeIcon,
  LockIcon,
  Menu01Icon,
  MoonIcon,
  PencilEdit02Icon,
  PlayIcon,
  PlusSignIcon,
  ScanIcon,
  Search01Icon,
  SecurityCheckIcon,
  ServerStack01Icon,
  ShieldIcon,
  SunIcon,
  TagsIcon,
  TerminalIcon,
  TimerIcon,
  UserIcon,
} from "@hugeicons/core-free-icons";
import type { IconName } from "../data/landing";

export type UiIconName =
  | IconName
  | "arrow-right"
  | "arrow"
  | "arrow-up-right"
  | "book"
  | "check"
  | "chevron-down"
  | "chevron-left"
  | "chevron-right"
  | "close"
  | "corner-down-right"
  | "cloud-off"
  | "compass"
  | "copy"
  | "cursor"
  | "dashboard"
  | "expand"
  | "folder"
  | "github"
  | "info"
  | "laptop"
  | "lock"
  | "menu"
  | "monitor"
  | "moon"
  | "network"
  | "pencil"
  | "plus"
  | "scan"
  | "server"
  | "shield-check"
  | "sun"
  | "user";

interface Props {
  name: UiIconName;
  class?: string;
}

const { name, class: className = "size-4" } = Astro.props;

const icons = {
  "arrow-right": ArrowRight01Icon,
  arrow: ArrowRight02Icon,
  "arrow-up-right": ArrowUpRight01Icon,
  "bar-chart-3": ChartColumnIcon,
  book: BookOpen01Icon,
  bookmark: BookmarkIcon,
  check: CheckIcon,
  "chevron-down": ArrowDown01Icon,
  "chevron-left": ChevronLeftIcon,
  "chevron-right": ChevronRightIcon,
  close: Cancel01Icon,
  "cloud-off": CloudOffIcon,
  "corner-down-right": ArrowMoveDownRightIcon,
  compass: Compass01Icon,
  copy: CopyIcon,
  cursor: Cursor01Icon,
  dashboard: DashboardSquare01Icon,
  database: DatabaseIcon,
  expand: ExpandIcon,
  eye: EyeIcon,
  file: File01Icon,
  folder: Folder01Icon,
  github: GithubIcon,
  info: InformationCircleIcon,
  keyboard: KeyboardIcon,
  laptop: LaptopIcon,
  "list-tree": ListTreeIcon,
  lock: LockIcon,
  menu: Menu01Icon,
  monitor: ComputerIcon,
  moon: MoonIcon,
  network: HierarchySquare02Icon,
  pencil: PencilEdit02Icon,
  play: PlayIcon,
  plus: PlusSignIcon,
  scan: ScanIcon,
  search: Search01Icon,
  server: ServerStack01Icon,
  shield: ShieldIcon,
  "shield-check": SecurityCheckIcon,
  sun: SunIcon,
  tags: TagsIcon,
  terminal: TerminalIcon,
  timer: TimerIcon,
  user: UserIcon,
} satisfies Record<UiIconName, unknown>;

// Hugeicons 的图形数据用 React 风格的 camelCase 属性，渲染原生 SVG 需转成 kebab-case。
const body = icons[name]
  .map(([tag, attrs]) => {
    const rendered = Object.entries(attrs)
      .filter(([key]) => key !== "key")
      .map(
        ([key, value]) =>
          `${key.replace(/[A-Z]/g, (c) => `-${c.toLowerCase()}`)}="${value}"`,
      )
      .join(" ");
    return `<${tag} ${rendered}/>`;
  })
  .join("");
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  class={className}
  aria-hidden="true"
>
  <Fragment set:html={body} />
</svg>
