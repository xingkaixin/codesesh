---
import { experience } from "../data/experience";
import type { Locale } from "../data/landing";
import Agents from "./Agents.astro";
import FAQ from "./FAQ.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import HubWorker from "./HubWorker.astro";
import LocalBoundary from "./LocalBoundary.astro";
import ProductShowcase from "./ProductShowcase.astro";
import Updates from "./Updates.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="skip-link" href="#main-content">
  {experience[locale].skip}
</a>
<Header locale={locale} page="landing" />
<main id="main-content">
  <Hero locale={locale} />
  <div class="frame landing-frame">
    <div class="panel landing-panel">
      <ProductShowcase locale={locale} />
      <Features locale={locale} />
      <LocalBoundary locale={locale} />
      <HubWorker locale={locale} />
      <Agents locale={locale} />
      <Updates locale={locale} />
      <FAQ locale={locale} />
    </div>
  </div>
</main>
<Footer locale={locale} showInstall={true} />

<style>
  .landing-frame {
    padding: 16px 8px 16px;
  }
  .landing-panel > :global(:first-child.sec) {
    border-top: 0;
  }
</style>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove("reveal-pending");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>("[data-reveal]")
      .forEach((element) => {
        if (element.getBoundingClientRect().top < window.innerHeight) return;
        element.classList.add("reveal-pending");
        observer.observe(element);
      });
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true },
    );
  }
</script>
