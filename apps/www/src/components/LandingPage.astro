---
import { experience } from "../data/experience";
import type { Locale } from "../data/landing";
import Agents from "./Agents.astro";
import CallToAction from "./CallToAction.astro";
import FAQ from "./FAQ.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import GuidesSection from "./GuidesSection.astro";
import Hero from "./Hero.astro";
import LatestUpdate from "./LatestUpdate.astro";
import ProductShowcase from "./ProductShowcase.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<div class="landing-page console-ui min-h-dvh bg-[var(--console-bg)] text-[var(--console-text)]">
  <a class="skip-link" href="#main-content">
    {experience[locale].skip}
  </a>
  <Header locale={locale} />
  <main id="main-content">
    <Hero locale={locale} />
    <ProductShowcase locale={locale} />
    <Features locale={locale} />
    <Agents locale={locale} />
    <div class="landing-resources section-shell section-space">
      <LatestUpdate locale={locale} />
      <GuidesSection locale={locale} />
    </div>
    <FAQ locale={locale} />
    <CallToAction locale={locale} />
  </main>
  <Footer locale={locale} />
</div>

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove("reveal-pending");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>("[data-reveal]")
      .forEach((element) => {
        if (element.getBoundingClientRect().top < window.innerHeight) return;
        element.classList.add("reveal-pending");
        observer.observe(element);
      });
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true },
    );
  }
</script>

<style>
  .landing-resources {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    align-items: center;
    gap: 5rem;
  }
  @media (max-width: 1023px) {
    .landing-resources {
      gap: 2.5rem;
    }
  }
  @media (max-width: 767px) {
    .landing-resources {
      grid-template-columns: 1fr;
      gap: 3rem;
    }
  }
</style>
