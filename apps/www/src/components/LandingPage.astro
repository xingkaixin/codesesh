---
import { experience } from "../data/experience";
import type { Locale } from "../data/landing";
import Agents from "./Agents.astro";
import CallToAction from "./CallToAction.astro";
import FAQ from "./FAQ.astro";
import Features from "./Features.astro";
import Footer from "./Footer.astro";
import Header from "./Header.astro";
import Hero from "./Hero.astro";
import HubWorker from "./HubWorker.astro";
import LocalBoundary from "./LocalBoundary.astro";
import ProductShowcase from "./ProductShowcase.astro";
import Updates from "./Updates.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<a class="skip-link" href="#main-content">
  {experience[locale].skip}
</a>
<Header locale={locale} />
<div class="frame">
  <main id="main-content" class="panel">
    <Hero locale={locale} />
    <ProductShowcase locale={locale} />
    <Features locale={locale} />
    <LocalBoundary locale={locale} />
    <HubWorker locale={locale} />
    <Agents locale={locale} />
    <Updates locale={locale} />
    <FAQ locale={locale} />
    <CallToAction locale={locale} />
  </main>
</div>
<Footer locale={locale} />

<script>
  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.remove("reveal-pending");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.08 },
    );
    document
      .querySelectorAll<HTMLElement>("[data-reveal]")
      .forEach((element) => {
        if (element.getBoundingClientRect().top < window.innerHeight) return;
        element.classList.add("reveal-pending");
        observer.observe(element);
      });
    document.addEventListener(
      "astro:before-swap",
      () => observer.disconnect(),
      { once: true },
    );
  }
</script>
