---
import { copy, type Locale } from "../data/landing";
import OverviewScene from "./product-demo/OverviewScene.astro";
import ProjectsScene from "./product-demo/ProjectsScene.astro";
import ReplayScene from "./product-demo/ReplayScene.astro";

type ProductScene = "overview" | "projects" | "replay";

interface Props {
  locale: Locale;
  id: string;
  scene: ProductScene;
}

const { locale, id, scene } = Astro.props;
const t = copy[locale].tour;
const previewLabel =
  scene === "overview"
    ? t.overview
    : scene === "projects"
      ? t.projects
      : t.replay;
---

<div
  id={id}
  class="product-demo"
  data-product-demo={scene}
  data-scene={scene}
  data-sample-sessions-template={t.sampleSessions}
>
  <div
    class="demo-viewport"
    role="region"
    aria-label={`${t.previewLabel}: ${previewLabel}`}
    tabindex="0"
  >
    <div class="demo-shell">
      {scene === "overview" && <OverviewScene id={id} locale={locale} />}
      {scene === "projects" && <ProjectsScene locale={locale} />}
      {scene === "replay" && <ReplayScene id={id} locale={locale} />}
    </div>
  </div>
</div>

<style>
  .product-demo {
    width: 100%;
    max-width: 100%;
    min-width: 0;
    color: var(--console-text);
    font-family: var(--font-sans);
  }

  .demo-viewport {
    width: 100%;
    max-width: 100%;
    overflow-x: auto;
    padding-bottom: 0.35rem;
    overscroll-behavior-inline: contain;
    scrollbar-color: var(--console-border-strong) transparent;
    scrollbar-width: thin;
  }

  .demo-viewport:focus-visible {
    outline: 2px solid var(--brand);
    outline-offset: 3px;
  }

  .demo-shell {
    min-width: 47.5rem;
    overflow: hidden;
    border: 1px solid var(--console-border);
    border-radius: var(--radius-lg);
    background: var(--console-surface);
    box-shadow: var(--elevation-overlay);
  }

  @media (max-width: 820px) {
    .demo-viewport {
      -webkit-overflow-scrolling: touch;
    }
  }
</style>
