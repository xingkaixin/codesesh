---
import { copy, type Locale } from "../data/landing";

type ProductScene = "overview" | "projects" | "replay";

interface Props {
  locale: Locale;
  id: string;
  scene: ProductScene;
}

interface RangeDatum {
  chip: string;
  meta: string;
  kpis: Array<{
    label: string;
    value: string;
    trend: string;
    hint: string;
    emphasis?: boolean;
  }>;
  bars: Array<{ label: string; value: number }>;
  distribution: Array<{
    name: string;
    icon: string;
    count: number;
    pct: number;
  }>;
}

const { locale, id, scene } = Astro.props;
const t = copy[locale].tour;

const labels =
  locale === "zh"
    ? {
        search: "搜索示例会话",
        range: "示例数据时间范围",
        overview: "概览示例界面",
        projects: "项目树示例界面",
        replay: "会话回放示例界面",
        filters: "切换消息类型的显示与隐藏",
        visibleStatus: "当前显示 {count} 条消息",
      }
    : {
        search: "Search sample sessions",
        range: "Sample data time range",
        overview: "Overview demo interface",
        projects: "Project tree demo interface",
        replay: "Session replay demo interface",
        filters: "Toggle message types on or off",
        visibleStatus: "Showing {count} messages",
      };

const overviewRanges = {
  "7d": {
    chip: "Last 7d / Apr 16-23, 2026",
    meta: "212 sessions / last 7 days",
    kpis: [
      { label: "Sessions", value: "212", trend: "+18.4%", hint: "30.3/day" },
      {
        label: "Messages",
        value: "32,764",
        trend: "+12.1%",
        hint: "154.5/session",
      },
      {
        label: "Tokens",
        value: "1.58B",
        trend: "+9.7%",
        hint: "Cache hit 61%",
      },
      {
        label: "Cost",
        value: "$84.20",
        trend: "+7.2%",
        hint: "$18.40 estimated",
        emphasis: true,
      },
      {
        label: "Last activity",
        value: "2h",
        trend: "",
        hint: "webapp / Claude Code",
      },
    ],
    bars: [
      { label: "Apr 17", value: 62 },
      { label: "Apr 18", value: 31 },
      { label: "Apr 19", value: 57 },
      { label: "Apr 20", value: 44 },
      { label: "Apr 21", value: 33 },
      { label: "Apr 22", value: 22 },
      { label: "Apr 23", value: 19 },
    ],
    distribution: [
      {
        name: "Claude Code",
        icon: "/icon/agent/claudecode.svg",
        count: 142,
        pct: 67,
      },
      { name: "Codex", icon: "/icon/agent/codex.svg", count: 39, pct: 18.4 },
      {
        name: "OpenCode",
        icon: "/icon/agent/opencode.svg",
        count: 18,
        pct: 8.5,
      },
      { name: "Kimi", icon: "/icon/agent/kimi.svg", count: 11, pct: 5.2 },
      { name: "Cursor", icon: "/icon/agent/cursor.svg", count: 2, pct: 0.9 },
    ],
  },
  "30d": {
    chip: "Last 30d / Mar 25-Apr 23, 2026",
    meta: "863 sessions / last 30 days",
    kpis: [
      { label: "Sessions", value: "863", trend: "+24.0%", hint: "28.8/day" },
      {
        label: "Messages",
        value: "128,410",
        trend: "+21.6%",
        hint: "148.8/session",
      },
      {
        label: "Tokens",
        value: "6.42B",
        trend: "+16.3%",
        hint: "Cache hit 58%",
      },
      {
        label: "Cost",
        value: "$341.90",
        trend: "+19.5%",
        hint: "$71.20 estimated",
        emphasis: true,
      },
      {
        label: "Last activity",
        value: "2h",
        trend: "",
        hint: "webapp / Claude Code",
      },
    ],
    bars: [
      { label: "W13", value: 38 },
      { label: "W14", value: 54 },
      { label: "W15", value: 47 },
      { label: "W16", value: 66 },
      { label: "W17", value: 72 },
      { label: "W18", value: 58 },
      { label: "W19", value: 41 },
    ],
    distribution: [
      {
        name: "Claude Code",
        icon: "/icon/agent/claudecode.svg",
        count: 502,
        pct: 58.2,
      },
      { name: "Codex", icon: "/icon/agent/codex.svg", count: 173, pct: 20.1 },
      {
        name: "OpenCode",
        icon: "/icon/agent/opencode.svg",
        count: 90,
        pct: 10.4,
      },
      { name: "Kimi", icon: "/icon/agent/kimi.svg", count: 59, pct: 6.8 },
      { name: "Cursor", icon: "/icon/agent/cursor.svg", count: 39, pct: 4.5 },
    ],
  },
  all: {
    chip: "All time / since Jun 2025",
    meta: "2,417 sessions / all history",
    kpis: [
      { label: "Sessions", value: "2,417", trend: "", hint: "11 months" },
      { label: "Messages", value: "371,205", trend: "", hint: "153.6/session" },
      { label: "Tokens", value: "18.9B", trend: "", hint: "Cache hit 55%" },
      {
        label: "Cost",
        value: "$1,024.60",
        trend: "",
        hint: "$204.80 estimated",
        emphasis: true,
      },
      {
        label: "Last activity",
        value: "2h",
        trend: "",
        hint: "webapp / Claude Code",
      },
    ],
    bars: [
      { label: "Sep", value: 24 },
      { label: "Oct", value: 36 },
      { label: "Nov", value: 45 },
      { label: "Dec", value: 39 },
      { label: "Jan", value: 58 },
      { label: "Feb", value: 71 },
      { label: "Mar", value: 88 },
    ],
    distribution: [
      {
        name: "Claude Code",
        icon: "/icon/agent/claudecode.svg",
        count: 1242,
        pct: 51.4,
      },
      { name: "Codex", icon: "/icon/agent/codex.svg", count: 524, pct: 21.7 },
      {
        name: "OpenCode",
        icon: "/icon/agent/opencode.svg",
        count: 295,
        pct: 12.2,
      },
      { name: "Kimi", icon: "/icon/agent/kimi.svg", count: 215, pct: 8.9 },
      { name: "Cursor", icon: "/icon/agent/cursor.svg", count: 141, pct: 5.8 },
    ],
  },
} satisfies Record<"7d" | "30d" | "all", RangeDatum>;

const defaultRange = overviewRanges["7d"];
const defaultBarMax = Math.max(...defaultRange.bars.map((bar) => bar.value));
const rangePayload = JSON.stringify(overviewRanges).replaceAll("<", "\\u003c");
const previewLabel =
  scene === "overview"
    ? labels.overview
    : scene === "projects"
      ? labels.projects
      : labels.replay;
const sampleLabel = `${t.sampleLabel} / DEMO`;

const replayFilters = [
  { key: "user", label: locale === "zh" ? "用户消息" : "User", count: 4 },
  {
    key: "agent",
    label: locale === "zh" ? "Agent 回复" : "Agent responses",
    count: 15,
  },
  { key: "tools", label: locale === "zh" ? "工具调用" : "Tools", count: 22 },
  { key: "bash", label: "bash", count: 8 },
  { key: "edit-file", label: "edit_file", count: 6 },
] as const;
---

<div id={id} class="product-demo" data-product-demo={scene} data-scene={scene}>
  <div
    class="demo-viewport"
    role="region"
    aria-label={`${t.previewLabel}: ${previewLabel}`}
    tabindex="0"
  >
    <div class="demo-shell">
      {
        scene === "overview" && (
          <>
            <header class="demo-toolbar">
              <div class="demo-brand">
                <img src="/logo.svg?v=3" alt="" width="18" height="18" />
                <strong>CODESESH</strong>
              </div>
              <label class="demo-search">
                <span class="sr-only">{labels.search}</span>
                <input
                  type="search"
                  placeholder="Search sessions"
                  aria-label={labels.search}
                />
                <kbd>/</kbd>
              </label>
              <kbd class="demo-shortcut">? Shortcuts</kbd>
              <span class="demo-range-chip" data-demo-range-chip>
                {defaultRange.chip}
              </span>
              <span class="demo-sample-label">{sampleLabel}</span>
            </header>

            <div class="demo-frame">
              <aside class="demo-sidebar" aria-label="Sample projects">
                <nav>
                  <ul class="demo-nav-list">
                    <li aria-current="page" class="is-active">
                      <img src="/logo.svg?v=3" alt="" width="13" height="13" />
                      <span>Dashboard</span>
                    </li>
                    <li>
                      <>
                        <span>webapp</span>
                        <small>96</small>
                      </>
                    </li>
                    <li>
                      <>
                        <span>data-pipeline</span>
                        <small>54</small>
                      </>
                    </li>
                    <li>
                      <>
                        <span>integration-svc</span>
                        <small>38</small>
                      </>
                    </li>
                    <li>
                      <>
                        <span>internal-tools</span>
                        <small>24</small>
                      </>
                    </li>
                  </ul>
                </nav>
                <section aria-labelledby={`${id}-bookmarks`}>
                  <p id={`${id}-bookmarks`} class="demo-mini-heading">
                    Bookmarks
                  </p>
                  <ul class="demo-bookmarks">
                    <li>
                      <span>Refactor data ingestion pipeline</span>
                      <small>Codex</small>
                    </li>
                    <li>
                      <span>Implement onboarding wizard</span>
                      <small>Claude Code</small>
                    </li>
                  </ul>
                </section>
              </aside>

              <div class="demo-main">
                <header class="demo-panel-heading">
                  <span class="demo-context-label">Dashboard</span>
                  <div
                    class="demo-range-tabs"
                    role="group"
                    aria-label={labels.range}
                  >
                    <button
                      type="button"
                      data-demo-range="7d"
                      aria-pressed="true"
                    >
                      Last 7d
                    </button>
                    <button
                      type="button"
                      data-demo-range="30d"
                      aria-pressed="false"
                    >
                      Last 30d
                    </button>
                    <button
                      type="button"
                      data-demo-range="all"
                      aria-pressed="false"
                    >
                      All time
                    </button>
                  </div>
                </header>

                <dl class="demo-kpis">
                  {defaultRange.kpis.map((kpi, index) => (
                    <div
                      class:list={["demo-kpi", kpi.emphasis && "is-emphasis"]}
                      data-demo-kpi={index}
                    >
                      <dt>{kpi.label}</dt>
                      <dd data-demo-kpi-value>{kpi.value}</dd>
                      <dd class="demo-kpi-meta">
                        <span data-demo-kpi-trend>{kpi.trend}</span>{" "}
                        <span data-demo-kpi-hint>{kpi.hint}</span>
                      </dd>
                    </div>
                  ))}
                </dl>

                <figure class="demo-panel demo-activity">
                  <figcaption>
                    <strong>Daily Activity</strong>
                    <span data-demo-chart-meta>{defaultRange.meta}</span>
                  </figcaption>
                  <ol class="demo-bars">
                    {defaultRange.bars.map((bar, index) => (
                      <li
                        data-demo-bar={index}
                        aria-label={`${bar.label}: ${bar.value} sample sessions`}
                      >
                        <span class="demo-bar-track" aria-hidden="true">
                          <span
                            class="demo-bar-fill"
                            style={`--bar-scale:${bar.value / defaultBarMax}`}
                          />
                        </span>
                        <small data-demo-bar-label>{bar.label}</small>
                      </li>
                    ))}
                  </ol>
                </figure>

                <section
                  class="demo-panel demo-distribution"
                  aria-labelledby={`${id}-distribution`}
                >
                  <header>
                    <p id={`${id}-distribution`} role="heading" aria-level="3">
                      Agent Distribution
                    </p>
                    <span>5 agents / 212 sessions</span>
                  </header>
                  <ul>
                    {defaultRange.distribution.map((agent, index) => (
                      <li data-demo-agent={index}>
                        <img
                          class="demo-agent-icon"
                          src={agent.icon}
                          alt=""
                          width="14"
                          height="14"
                          loading="lazy"
                          data-monochrome={
                            agent.name === "Claude Code" ? undefined : ""
                          }
                        />
                        <span data-demo-agent-name>{agent.name}</span>
                        <span class="demo-agent-meter" aria-hidden="true">
                          <span
                            style={`--agent-scale:${agent.pct / 100}`}
                            data-demo-agent-fill
                          />
                        </span>
                        <progress value={agent.pct} max={100}>
                          {agent.pct}%
                        </progress>
                        <small
                          data-demo-agent-stat
                        >{`${agent.count} / ${agent.pct.toFixed(1)}%`}</small>
                      </li>
                    ))}
                  </ul>
                </section>
              </div>
            </div>
            <script
              is:inline
              type="application/json"
              data-demo-ranges
              set:html={rangePayload}
            />
          </>
        )
      }

      {
        scene === "projects" && (
          <>
            <header class="demo-toolbar demo-toolbar-simple">
              <div class="demo-brand">
                <img src="/logo.svg?v=3" alt="" width="18" height="18" />
                <strong>CODESESH</strong>
              </div>
              <span class="demo-breadcrumb">Dashboard / webapp</span>
              <span class="demo-range-chip">Last 7d / Apr 16-23</span>
              <span class="demo-sample-label">{sampleLabel}</span>
            </header>

            <div class="demo-frame demo-project-frame">
              <aside class="demo-sidebar" aria-label="Sample projects">
                <nav>
                  <ul class="demo-nav-list">
                    <li>
                      <img src="/logo.svg?v=3" alt="" width="13" height="13" />
                      <span>Dashboard</span>
                    </li>
                    <li aria-current="page" class="is-active">
                      <>
                        <span>webapp</span>
                        <small>96</small>
                      </>
                    </li>
                    <li>
                      <>
                        <span>data-pipeline</span>
                        <small>54</small>
                      </>
                    </li>
                    <li>
                      <>
                        <span>integration-svc</span>
                        <small>38</small>
                      </>
                    </li>
                  </ul>
                </nav>
              </aside>

              <div class="demo-main demo-project-main">
                <header class="demo-project-heading">
                  <p role="heading" aria-level="3">
                    webapp
                  </p>
                  <span>96 sessions / 4 agents / /projects/webapp</span>
                </header>
                <p class="demo-date">APR 23, 2026 / THURSDAY</p>

                <div class="demo-session-list">
                  <details class="demo-session-card" data-demo-subsession>
                    <summary>
                      <time>10:22</time>
                      <span class="demo-agent-frame">
                        <img
                          src="/icon/agent/claudecode.svg"
                          alt=""
                          width="13"
                          height="13"
                          loading="lazy"
                        />
                      </span>
                      <span class="demo-session-copy">
                        <strong>Implement onboarding wizard flow</strong>
                        <small>
                          Claude Code / 84 msgs / 412K tok / 3 sub-sessions
                        </small>
                      </span>
                      <span class="demo-sub-count">3 sub</span>
                      <span class="demo-cost">$1.86 incl. sub</span>
                    </summary>
                    <ol class="demo-sub-sessions">
                      <li>
                        <>
                          <time>10:26</time>
                          <span>Generate step validation schema</span>
                          <small>22 msgs / 96K tok</small>
                        </>
                      </li>
                      <li>
                        <>
                          <time>10:41</time>
                          <span>Write WelcomeStep component tests</span>
                          <small>17 msgs / 71K tok</small>
                        </>
                      </li>
                      <li>
                        <>
                          <time>11:03</time>
                          <span>Audit a11y on the wizard stepper</span>
                          <small>9 msgs / 38K tok</small>
                        </>
                      </li>
                    </ol>
                  </details>

                  <article class="demo-session-card demo-session-static">
                    <time>09:48</time>
                    <span class="demo-agent-frame">
                      <img
                        class="demo-agent-icon"
                        src="/icon/agent/codex.svg"
                        alt=""
                        width="13"
                        height="13"
                        loading="lazy"
                        data-monochrome
                      />
                    </span>
                    <span class="demo-session-copy">
                      <strong>Refactor query building for readability</strong>
                      <small>Codex / 41 msgs / 188K tok</small>
                    </span>
                    <span class="demo-cost">$0.74</span>
                  </article>

                  <details class="demo-session-card" data-demo-subsession>
                    <summary>
                      <time>08:15</time>
                      <span class="demo-agent-frame">
                        <img
                          class="demo-agent-icon"
                          src="/icon/agent/opencode.svg"
                          alt=""
                          width="13"
                          height="13"
                          loading="lazy"
                          data-monochrome
                        />
                      </span>
                      <span class="demo-session-copy">
                        <strong>Fix webhook signature verification bug</strong>
                        <small>
                          OpenCode / 29 msgs / 104K tok / 1 sub-session
                        </small>
                      </span>
                      <span class="demo-sub-count">1 sub</span>
                      <span class="demo-cost">$0.41 incl. sub</span>
                    </summary>
                    <ol class="demo-sub-sessions">
                      <li>
                        <>
                          <time>08:31</time>
                          <span>Reproduce the HMAC mismatch locally</span>
                          <small>11 msgs / 34K tok</small>
                        </>
                      </li>
                    </ol>
                  </details>

                  <article class="demo-session-card demo-session-static">
                    <time>07:02</time>
                    <span class="demo-agent-frame">
                      <img
                        class="demo-agent-icon"
                        src="/icon/agent/cursor.svg"
                        alt=""
                        width="13"
                        height="13"
                        loading="lazy"
                        data-monochrome
                      />
                    </span>
                    <span class="demo-session-copy">
                      <strong>Tune session list virtualization</strong>
                      <small>Cursor / 18 msgs / 63K tok</small>
                    </span>
                    <span class="demo-cost">$0.22</span>
                  </article>
                </div>
              </div>
            </div>
          </>
        )
      }

      {
        scene === "replay" && (
          <>
            <header class="demo-replay-toolbar">
              <p>Dashboard / Codex / Refactor query building for readability</p>
              <div>
                <span class="demo-context-label">Session</span>
                <strong>Refactor query building for readability</strong>
                <small>#9c7a2d1b / updated 7h ago</small>
                <span class="demo-sample-label">{sampleLabel}</span>
              </div>
            </header>

            <div class="demo-replay-frame">
              <aside class="demo-replay-sidebar">
                <fieldset class="demo-toc">
                  <legend>Session TOC</legend>
                  <div role="group" aria-label={labels.filters}>
                    {replayFilters.map((filter) => (
                      <label>
                        <input
                          type="checkbox"
                          checked
                          data-replay-filter={filter.key}
                          aria-controls={`${id}-messages`}
                        />
                        <span>{filter.label}</span>
                        <small>{filter.count}</small>
                      </label>
                    ))}
                  </div>
                </fieldset>

                <section
                  class="demo-file-tracker"
                  aria-labelledby={`${id}-files`}
                >
                  <p id={`${id}-files`} role="heading" aria-level="3">
                    File Tracker
                  </p>
                  <dl>
                    <div>
                      <>
                        <dt>EDIT</dt>
                        <dd>2</dd>
                      </>
                    </div>
                    <div>
                      <>
                        <dt>WRITE</dt>
                        <dd>8</dd>
                      </>
                    </div>
                  </dl>
                </section>
              </aside>

              <div class="demo-message-main">
                <span
                  class="sr-only"
                  aria-live="polite"
                  data-replay-status
                  data-status-template={labels.visibleStatus}
                >
                  {labels.visibleStatus.replace("{count}", "3")}
                </span>
                <ol id={`${id}-messages`} class="demo-message-list">
                  <li data-replay-item="user" data-replay-message>
                    <article class="demo-message">
                      <span class="demo-avatar" aria-hidden="true">
                        U
                      </span>
                      <div>
                        <header>
                          <>
                            <strong>USER</strong>
                            <time>10:22:13</time>
                          </>
                        </header>
                        <p class="demo-message-box">
                          The current query builder is hard to follow. Refactor
                          it into composable helpers and document the intent of
                          each step.
                        </p>
                      </div>
                    </article>
                  </li>

                  <li data-replay-item="agent" data-replay-message>
                    <article class="demo-message">
                      <span class="demo-avatar">
                        <img
                          class="demo-agent-icon"
                          src="/icon/agent/codex.svg"
                          alt="Codex"
                          width="15"
                          height="15"
                          loading="lazy"
                          data-monochrome
                        />
                      </span>
                      <div>
                        <header>
                          <>
                            <strong>AGENT</strong>
                            <time>10:22:18</time>
                            <small>gpt-5.4</small>
                          </>
                        </header>
                        <div class="demo-agent-response">
                          <p>
                            I will split the builder into focused functions and
                            keep its behavior intact.
                          </p>

                          <details
                            class="demo-tool-call"
                            data-demo-tool="edit_file"
                            data-replay-item="tools edit-file"
                          >
                            <summary>
                              <span>edit_file</span>
                              <code>src/db/queryBuilder.ts</code>
                              <strong>EDITED</strong>
                              <small>
                                <ins>+128</ins> <del>-46</del>
                              </small>
                            </summary>
                            <pre>
                              <code>
                                <span>@@ buildQuery()</span>
                                <del>- const parts = [];</del>
                                <del>
                                  - return appendFilters(parts, filters);
                                </del>
                                <ins>
                                  + const clauses = buildClauses(filters);
                                </ins>
                                <ins>
                                  + return clauses.filter(Boolean).join(" AND
                                  ");
                                </ins>
                              </code>
                            </pre>
                          </details>

                          <details
                            class="demo-tool-call"
                            data-demo-tool="bash"
                            data-replay-item="tools bash"
                          >
                            <summary>
                              <span>bash</span>
                              <code>pnpm test:unit</code>
                              <strong class="is-success">SUCCESS</strong>
                            </summary>
                            <p class="demo-tool-result">
                              <>
                                <strong>148 passed</strong>
                                <span>0 failed / 2.34s</span>
                              </>
                            </p>
                          </details>
                        </div>
                      </div>
                    </article>
                  </li>

                  <li data-replay-item="agent" data-replay-message>
                    <article class="demo-message">
                      <span class="demo-avatar">
                        <img
                          class="demo-agent-icon"
                          src="/icon/agent/codex.svg"
                          alt="Codex"
                          width="15"
                          height="15"
                          loading="lazy"
                          data-monochrome
                        />
                      </span>
                      <div>
                        <header>
                          <>
                            <strong>AGENT</strong>
                            <time>10:24:31</time>
                          </>
                        </header>
                        <div class="demo-agent-response">
                          <p>
                            Updated the builder, added types and focused
                            comments, and kept behavior intact.
                          </p>
                          <div class="demo-write-row">
                            <span>write</span>
                            <code>src/db/queryBuilder.spec.ts</code>
                            <strong>+86 lines</strong>
                          </div>
                        </div>
                      </div>
                    </article>
                  </li>
                </ol>
              </div>
            </div>
          </>
        )
      }
    </div>
  </div>
</div>

<script>
  interface DemoKpi {
    value: string;
    trend: string;
    hint: string;
  }

  interface DemoBar {
    label: string;
    value: number;
  }

  interface DemoAgent {
    count: number;
    pct: number;
  }

  interface DemoRange {
    chip: string;
    meta: string;
    kpis: DemoKpi[];
    bars: DemoBar[];
    distribution: DemoAgent[];
  }

  function initializeOverviewDemo(root: HTMLElement) {
    const source = root.querySelector<HTMLScriptElement>("[data-demo-ranges]");
    if (!source?.textContent) return;

    let ranges: Record<string, DemoRange>;
    try {
      ranges = JSON.parse(source.textContent) as Record<string, DemoRange>;
    } catch {
      return;
    }

    const buttons = Array.from(
      root.querySelectorAll<HTMLButtonElement>("[data-demo-range]"),
    );
    const chip = root.querySelector<HTMLElement>("[data-demo-range-chip]");
    const meta = root.querySelector<HTMLElement>("[data-demo-chart-meta]");

    function renderRange(key: string) {
      const range = ranges[key];
      if (!range) return;

      buttons.forEach((button) => {
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.demoRange === key),
        );
      });
      if (chip) chip.textContent = range.chip;
      if (meta) meta.textContent = range.meta;

      root.querySelectorAll<HTMLElement>("[data-demo-kpi]").forEach((item) => {
        const index = Number(item.dataset.demoKpi);
        const kpi = range.kpis[index];
        if (!kpi) return;
        const value = item.querySelector<HTMLElement>("[data-demo-kpi-value]");
        const trend = item.querySelector<HTMLElement>("[data-demo-kpi-trend]");
        const hint = item.querySelector<HTMLElement>("[data-demo-kpi-hint]");
        if (value) value.textContent = kpi.value;
        if (trend) trend.textContent = kpi.trend;
        if (hint) hint.textContent = kpi.hint;
      });

      const barMax = Math.max(...range.bars.map((bar) => bar.value));
      root.querySelectorAll<HTMLElement>("[data-demo-bar]").forEach((item) => {
        const index = Number(item.dataset.demoBar);
        const bar = range.bars[index];
        if (!bar) return;
        const fill = item.querySelector<HTMLElement>(".demo-bar-fill");
        const label = item.querySelector<HTMLElement>("[data-demo-bar-label]");
        fill?.style.setProperty("--bar-scale", String(bar.value / barMax));
        if (label) label.textContent = bar.label;
        item.setAttribute(
          "aria-label",
          `${bar.label}: ${bar.value} sample sessions`,
        );
      });

      root
        .querySelectorAll<HTMLElement>("[data-demo-agent]")
        .forEach((item) => {
          const index = Number(item.dataset.demoAgent);
          const agent = range.distribution[index];
          if (!agent) return;
          const fill = item.querySelector<HTMLElement>(
            "[data-demo-agent-fill]",
          );
          const progress = item.querySelector<HTMLProgressElement>("progress");
          const stat = item.querySelector<HTMLElement>(
            "[data-demo-agent-stat]",
          );
          fill?.style.setProperty("--agent-scale", String(agent.pct / 100));
          if (progress) progress.value = agent.pct;
          if (stat)
            stat.textContent = `${agent.count.toLocaleString()} / ${agent.pct.toFixed(1)}%`;
        });

      const total = range.distribution.reduce(
        (sum, agent) => sum + agent.count,
        0,
      );
      const distributionMeta = root.querySelector<HTMLElement>(
        ".demo-distribution header > span",
      );
      if (distributionMeta)
        distributionMeta.textContent = `5 agents / ${total.toLocaleString()} sessions`;
    }

    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const key = button.dataset.demoRange;
        if (key) renderRange(key);
      });
    });
  }

  function initializeReplayDemo(root: HTMLElement) {
    const filters = Array.from(
      root.querySelectorAll<HTMLInputElement>("[data-replay-filter]"),
    );
    const items = Array.from(
      root.querySelectorAll<HTMLElement>("[data-replay-item]"),
    );
    const status = root.querySelector<HTMLElement>("[data-replay-status]");

    function renderFilters() {
      const disabled = new Set(
        filters
          .filter((filter) => !filter.checked)
          .map((filter) => filter.dataset.replayFilter),
      );
      items.forEach((item) => {
        const types = item.dataset.replayItem?.split(" ") ?? [];
        item.hidden = types.some((type) => disabled.has(type));
      });

      const visibleCount = root.querySelectorAll<HTMLElement>(
        "[data-replay-message]:not([hidden])",
      ).length;
      if (status) {
        status.textContent = (
          status.dataset.statusTemplate ?? "{count}"
        ).replace("{count}", String(visibleCount));
      }
    }

    filters.forEach((filter) =>
      filter.addEventListener("change", renderFilters),
    );
  }

  document
    .querySelectorAll<HTMLElement>("[data-product-demo]")
    .forEach((root) => {
      if (root.dataset.scene === "overview") initializeOverviewDemo(root);
      if (root.dataset.scene === "replay") initializeReplayDemo(root);
    });
</script>

