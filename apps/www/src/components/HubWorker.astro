---
import { guideRoutes } from "../data/guides";
import type { Locale } from "../data/landing";
import { sections } from "../data/sections";
import { fill, showcase } from "../data/showcase";
import HeadingText from "./HeadingText.astro";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const s = sections[locale].hub;
const h = showcase[locale].hub;
---

<section id="hub" class="sec" aria-labelledby="hub-heading">
  <div class="shell hub">
    <div data-reveal>
      <h2 id="hub-heading" class="h2">
        <HeadingText value={s.title} />
      </h2>
      <p class="lead hub-body">{s.body}</p>
      <ol class="points">
        {s.points.map(([title, body], index) => (
          <li class="pt">
            <span class="pt-n">0{index + 1}</span>
            <div>
              <h3 class="pt-t">{title}</h3>
              <p class="pt-d">{body}</p>
            </div>
          </li>
        ))}
      </ol>
      <a
        class="tlink hub-guide"
        href={guideRoutes("multi-machine-sync")[locale]}
      >
        {s.guide}
        <Icon name="arrow" />
      </a>
    </div>
    <div class="hd" data-reveal aria-hidden="true">
      <div class="hubc">
        <div class="r1">
          <span class="ic-w">
            <Icon name="server" />
          </span>
          <div>
            Hub<div class="host">{h.host}</div>
          </div>
        </div>
        <p class="role">{s.hubRole}</p>
        <div class="stats">
          <span class="glass">
            <span class="live"></span>
            {h.online}
          </span>
          <span class="glass">{s.hubFoot}</span>
        </div>
      </div>
      <div class="links">
        <span class="lk">
          <span class="up"></span>
        </span>
        <span class="lk">
          <span class="up"></span>
        </span>
        <span class="lk off">
          <span class="x">
            <Icon name="close" class="size-3" />
          </span>
        </span>
      </div>
      <div class="wk">
        <div class="wn">
          <div class="wn-h">
            <Icon name="laptop" class="size-3.5" />
            laptop
          </div>
          <div class="wn-os">macOS · Worker</div>
          <span class="st ok3">
            <i></i>
            {s.connected}
          </span>
          <div class="wn-f">{h.synced}</div>
        </div>
        <div class="wn">
          <div class="wn-h">
            <Icon name="server" class="size-3.5" />
            devbox
          </div>
          <div class="wn-os">Linux · Worker</div>
          <span class="st busy">
            <i></i>
            {s.collecting}
          </span>
          <div class="prog">
            <i></i>
          </div>
        </div>
        <div class="wn">
          <div class="wn-h">
            <Icon name="monitor" class="size-3.5" />
            desktop
          </div>
          <div class="wn-os">Windows · Worker</div>
          <span class="st off">
            <i></i>
            {s.offline}
          </span>
          <div class="wn-f">
            {fill(s.queued, { count: 12 })} · {h.catchUp}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hub {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: 64px;
    align-items: center;
  }
  .hub-body {
    margin-top: 24px;
  }
  .points {
    display: grid;
    gap: 22px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
  }
  .pt {
    display: grid;
    grid-template-columns: 36px minmax(0, 1fr);
    gap: 14px;
  }
  .pt-n {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--brand-line);
    border-radius: 11px;
    background: var(--brand-soft);
    color: var(--brand-ink);
    font: 500 12px/1 var(--mono);
  }
  .pt-t {
    margin: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .pt-d {
    margin: 4px 0 0;
    color: var(--text-2);
    font-size: 13.5px;
    line-height: 1.7;
  }
  .hub-guide {
    margin-top: 32px;
  }
  .hd {
    position: relative;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: 24px;
    background-color: var(--frame);
    background-image: radial-gradient(var(--grid-dot) 1px, transparent 1px);
    background-size: 18px 18px;
  }
  .hubc {
    position: relative;
    z-index: 1;
    overflow: hidden;
    padding: 20px 22px;
    border-radius: 18px;
    background: linear-gradient(135deg, var(--ember-from), var(--ember-to));
    box-shadow: var(--sh-overlay);
    color: #fff;
  }
  .hubc::after {
    position: absolute;
    top: -30px;
    right: -30px;
    width: 150px;
    height: 150px;
    border-radius: 50%;
    background: repeating-linear-gradient(
      -45deg,
      rgba(255, 255, 255, 0.1) 0 2px,
      transparent 2px 9px
    );
    content: "";
  }
  .r1 {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 15px;
    font-weight: 700;
  }
  .ic-w {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.18);
  }
  .host {
    color: rgba(255, 255, 255, 0.9);
    font: 400 11px/1.4 var(--mono);
  }
  .role {
    margin: 12px 0 0;
    color: rgba(255, 255, 255, 0.9);
    font-size: 12.5px;
  }
  .stats {
    position: relative;
    z-index: 1;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }
  .glass {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 28px;
    padding: 4px 11px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
    font: 500 11px/1.4 var(--mono);
  }
  .glass .live {
    background: var(--live);
    box-shadow: 0 0 0 3px rgba(139, 230, 207, 0.25);
  }
  .links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    height: 64px;
  }
  .lk {
    position: relative;
    justify-self: center;
    width: 2px;
    height: 100%;
    background: repeating-linear-gradient(
      to bottom,
      var(--border-strong) 0 4px,
      transparent 4px 8px
    );
  }
  .lk .up {
    position: absolute;
    left: -3px;
    width: 8px;
    height: 8px;
    border-radius: 2px;
    background: var(--brand);
    animation: up 1.5s linear infinite;
  }
  .lk:nth-child(2) .up {
    animation-duration: 2.2s;
    animation-delay: 0.7s;
  }
  .lk.off {
    opacity: 0.55;
  }
  .lk .x {
    position: absolute;
    top: 50%;
    left: 50%;
    display: grid;
    place-items: center;
    width: 22px;
    height: 22px;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--surface);
    color: var(--muted);
    transform: translate(-50%, -50%);
  }
  .wk {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }
  .wn {
    min-width: 0;
    padding: 14px;
    border: 1px solid var(--border);
    border-radius: 15px;
    background: var(--surface);
    box-shadow: var(--sh-raised);
  }
  .wn-h {
    display: flex;
    align-items: center;
    gap: 8px;
    font: 600 12px/1.2 var(--mono);
  }
  .wn-h :global(svg) {
    color: var(--text-2);
  }
  .wn-os {
    margin-top: 5px;
    color: var(--muted);
    font-size: 11px;
  }
  .st {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 24px;
    margin-top: 12px;
    padding: 0 9px;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    white-space: nowrap;
  }
  .st.ok3 {
    background: var(--pos-soft);
    color: var(--pos-ink);
  }
  .st.busy {
    background: var(--brand-soft);
    color: var(--brand-ink);
  }
  .st.off {
    background: var(--warn-soft);
    color: var(--warn-ink);
  }
  .st i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .prog {
    height: 4px;
    margin-top: 10px;
    overflow: hidden;
    border-radius: 999px;
    background: var(--muted-bg);
  }
  .prog i {
    display: block;
    width: 40%;
    height: 100%;
    border-radius: 999px;
    background: var(--brand);
    animation: indet 1.6s ease-in-out infinite;
  }
  .wn-f {
    margin-top: 10px;
    color: var(--muted);
    font: 400 10.5px/1.4 var(--mono);
  }

  @keyframes up {
    0% {
      top: calc(100% - 4px);
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      top: -4px;
      opacity: 0;
    }
  }
  @keyframes indet {
    from {
      transform: translateX(-100%);
    }
    to {
      transform: translateX(260%);
    }
  }

  @media (max-width: 1023px) {
    .hub {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }
  }
  @media (max-width: 760px) {
    .links {
      display: none;
    }
    .wk {
      grid-template-columns: minmax(0, 1fr);
      margin-top: 12px;
    }
    .hd {
      padding: 16px;
    }
  }
</style>
