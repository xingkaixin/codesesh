---
import { guideCopy, guideRoutes, guides } from "../data/guides";
import type { Locale } from "../data/landing";
import Icon from "./Icon.astro";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = guideCopy[locale];
const featured = guides.filter((guide) =>
  ["getting-started", "session-history", "usage-and-costs"].includes(
    guide.slug,
  ),
);
---

<section
  id="guides"
  class="guides-section"
  aria-labelledby="guides-heading"
  data-reveal
>
  <p class="landing-kicker">
    <b>06</b>
    {t.label}
  </p>
  <h2 id="guides-heading" class="console-display">
    {t.intro}
  </h2>
  <ul>
    {featured.map((guide) => (
      <li>
        <a href={guideRoutes(guide.slug)[locale]}>
          <span>{guide.copy[locale].title}</span>
          <Icon name="arrow-up-right" />
        </a>
      </li>
    ))}
  </ul>
  <a class="text-link" href={guideRoutes()[locale]}>
    {t.all}
    <Icon name="arrow-right" />
  </a>
</section>
<style>
  .guides-section {
    padding-block: 0.5rem;
    scroll-margin-top: 6rem;
  }
  .guides-section h2 {
    margin: 0 0 1.5rem;
    font-size: clamp(1.7rem, 2.2vw, 2.2rem);
    line-height: 1.2;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  ul {
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }
  li {
    border-bottom: 1px solid var(--console-border);
  }
  li a {
    display: flex;
    justify-content: space-between;
    gap: 1.5rem;
    align-items: center;
    min-height: 5.3rem;
    padding-block: 1rem;
    font-size: 0.95rem;
    line-height: 1.6;
  }
  li a {
    transition:
      padding var(--dur-base) var(--ease-out),
      color var(--dur-fast) var(--ease-out);
  }
  li a:hover {
    padding-left: 0.5rem;
    color: var(--brand-text);
  }
  li a :global(svg) {
    flex-shrink: 0;
  }
</style>
