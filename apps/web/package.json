{
  "name": "@codesesh/web",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "clean": "node ../../scripts/clean.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "test": "vitest run",
    "test:bundle": "vitest run --config vitest.bundle.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/ibm-plex-sans": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@fontsource-variable/space-grotesk": "catalog:",
    "@hugeicons/core-free-icons": "catalog:",
    "@hugeicons/react": "^1.1.10",
    "@pierre/trees": "1.0.0-beta.6",
    "@tanstack/react-query": "^5.102.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "diff": "^9.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "react-syntax-highlighter": "^16.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@codesesh/core": "workspace:*",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@typescript/native": "catalog:",
    "@vitejs/plugin-react": "^6.1.0",
    "happy-dom": "^20.11.6",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
