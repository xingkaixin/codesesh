{
  "name": "@codesesh/core",
  "version": "1.0.0",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.mjs",
      "require": "./dist/contract/index.js"
    },
    "./repository-facts": {
      "types": "./dist/repository-facts.d.ts",
      "import": "./dist/repository-facts.mjs",
      "require": "./dist/repository-facts.js"
    }
  },
  "scripts": {
    "build": "pnpm run typecheck && tsup && tsc6 --emitDeclarationOnly",
    "dev": "tsup --watch",
    "clean": "node ../../scripts/clean.mjs",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node22.json"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.20.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "node-gyp": "^13.0.1",
    "tsup": "^8.5.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3"
  }
}
