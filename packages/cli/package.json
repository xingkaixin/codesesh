{
  "name": "codesesh",
  "version": "1.0.5",
  "description": "Browse local AI coding-agent sessions in one Web UI.",
  "keywords": [
    "ai",
    "ai-agent",
    "cli",
    "coding-agent",
    "developer-tools",
    "history",
    "session",
    "visualization",
    "web-ui"
  ],
  "homepage": "https://codesesh.xingkaixin.me/",
  "bugs": {
    "url": "https://github.com/xingkaixin/codesesh/issues"
  },
  "license": "MIT",
  "author": "Kevin <xingkaixin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xingkaixin/codesesh.git",
    "directory": "packages/cli"
  },
  "bin": {
    "codesesh": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run typecheck && tsup && node scripts/copy-web-dist.js",
    "release": "pnpm run typecheck && tsup && node scripts/copy-web-dist.js",
    "dev": "tsup --watch",
    "clean": "node ../../scripts/clean.mjs",
    "start": "node dist/index.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "format:check": "oxfmt --check \"**/*.{js,mjs,cjs,ts,tsx}\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.node22.json"
  },
  "dependencies": {
    "@codesesh/core": "workspace:*",
    "@hono/node-server": "^2.1.1",
    "better-sqlite3": "catalog:",
    "citty": "^0.2.2",
    "consola": "^3.4.2",
    "hono": "^4.13.5",
    "open": "^11.0.2"
  },
  "devDependencies": {
    "@codesesh/web": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
