{
  "name": "codesesh-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm build:web && pnpm build:rust",
    "sync:version": "node scripts/sync-version.mjs",
    "dev": "pnpm build && node scripts/run-native.mjs",
    "dev:www": "pnpm --filter @codesesh/contract build && pnpm --filter @codesesh/www dev",
    "serve": "node scripts/run-native.mjs",
    "clean": "turbo run clean && node scripts/clean.mjs --native",
    "lint": "pnpm lint:root && turbo run lint",
    "lint:root": "node scripts/check-import-cycles.mjs && oxlint scripts tests crates/codesesh-cli/npm playwright.config.ts vitest.config.ts",
    "lint:fix": "pnpm lint:fix:root && turbo run lint:fix",
    "lint:fix:root": "oxlint scripts tests crates/codesesh-cli/npm playwright.config.ts vitest.config.ts --fix",
    "format": "pnpm format:root && turbo run format",
    "format:root": "oxfmt --write \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"crates/codesesh-cli/npm/**/*.{js,mjs,cjs,ts,tsx}\" playwright.config.ts vitest.config.ts",
    "format:check": "pnpm format:check:root && turbo run format:check",
    "format:check:root": "oxfmt --check \"scripts/**/*.{js,mjs,cjs,ts,tsx}\" \"tests/**/*.{js,mjs,cjs,ts,tsx}\" \"crates/codesesh-cli/npm/**/*.{js,mjs,cjs,ts,tsx}\" playwright.config.ts vitest.config.ts",
    "test": "pnpm --filter @codesesh/contract build && vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "test:backend": "node --test tests/backend-contract/backend.test.mjs",
    "prepare:reference": "node scripts/bench/prepare-backend-reference.mjs",
    "bench:backend": "node scripts/bench/benchmark-backend.mjs",
    "typecheck": "turbo run typecheck && node --check crates/codesesh-cli/npm/bin/codesesh.cjs",
    "typecheck:e2e": "pnpm --filter @codesesh/contract build && tsc --noEmit -p tsconfig.e2e.json",
    "package:artifact": "node scripts/package-artifact.mjs",
    "package:artifact:test": "node --test scripts/rust/packaging.test.mjs scripts/rust/publish.test.mjs",
    "package:smoke": "node scripts/rust/smoke.mjs --contracts",
    "bench:perf": "node scripts/bench/benchmark-performance.mjs",
    "perf:check": "node scripts/bench/perf-scale.mjs",
    "bench:session-index": "pnpm --filter @codesesh/contract build && node scripts/bench/benchmark-session-index.mjs",
    "check:coverage-scopes": "node scripts/critical-coverage.mjs",
    "test:coverage": "pnpm check:coverage-scopes && vitest run --coverage",
    "deploy:www": "pnpm --filter @codesesh/contract build && pnpm --filter @codesesh/www deploy:cf",
    "build:rust": "cargo build --release --locked",
    "generate:rust-contract": "cargo run --locked -p codesesh-core --example export_contract && oxfmt --write packages/contract/src/generated",
    "build:web": "turbo run build --filter=@codesesh/contract --filter=@codesesh/web --filter=@codesesh/www",
    "test:rust": "cargo test --workspace --locked",
    "test:rust:platform": "cargo test -p codesesh-core --lib --locked -- discovery:: data_migration:: runtime:: state:: storage::schema:: storage::memory:: pricing::manager:: sync::worker_store:: agents::antigravity_cli:: agents::cursor:: agents::dsh:: agents::kimi:: projects:: && cargo test -p codesesh-cli --bin codesesh --locked -- cache_open:: logging:: pricing_refresh:: service:: worker::connection:: && cargo test -p codesesh-cli --test data_migration --test hub_worker --test worker_scheduling --locked",
    "bench:rust": "node scripts/rust/benchmark.mjs"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.89.0",
    "@shadcn/lint": "0.2.3",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "^5.0.5",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "playwright": "^1.64.1",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "vitest": "^5.0.5",
    "@codesesh/contract": "workspace:*"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.0.0"
  }
}
